wide_for_dam$asn_prop_dead_T2<-asin(sqrt(wide_for_dam$prop_dead_T2))
wide_for_dam$asn_prop_dead_T3<-asin(sqrt(wide_for_dam$prop_dead_T3))
wide_for_dam$asn_prop_LRR_dead_T1<-asin(sqrt(wide_for_dam$prop_LRR_dead_T1))
wide_for_dam$asn_prop_LRR_dead_T2<-asin(sqrt(wide_for_dam$prop_LRR_dead_T2))
wide_for_dam$asn_prop_LRR_dead_T3<-asin(sqrt(wide_for_dam$prop_LRR_dead_T3))
wide_for_dam$asn_prop_LRRNO_dead_T1<-asin(sqrt(wide_for_dam$prop_LRRNO_dead_T1))
wide_for_dam$asn_prop_LRRNO_dead_T2<-asin(sqrt(wide_for_dam$prop_LRRNO_dead_T2))
wide_for_dam$asn_prop_LRRNO_dead_T3<-asin(sqrt(wide_for_dam$prop_LRRNO_dead_T3))
wide_for_dam$asn_prop_SUP_dead_T1<-asin(sqrt(wide_for_dam$prop_SUP_dead_T1))
wide_for_dam$asn_prop_SUP_dead_T2<-asin(sqrt(wide_for_dam$prop_SUP_dead_T2))
wide_for_dam$asn_prop_SUP_dead_T3<-asin(sqrt(wide_for_dam$prop_SUP_dead_T3))
wide_for_dam$asn_prop_No_damage_dead_T1<-asin(sqrt(wide_for_dam$prop_No_damage_dead_T1))
wide_for_dam$asn_prop_No_damage_dead_T2<-asin(sqrt(wide_for_dam$prop_No_damage_dead_T2))
wide_for_dam$asn_prop_No_damage_dead_T3<-asin(sqrt(wide_for_dam$prop_No_damage_dead_T3))
#add live BA to stands
#select the summary stats just for dead trees
wide2_live<-wide_stand_stats[which(wide2$STATUS==1),c(1,3,4,5)]
#calculate slopes
wide_for_dam$early_BA_slope<-(wide_for_dam$Live_BA_mpha_T2-wide_for_dam$Live_BA_mpha_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_BA_slope<-(wide_for_dam$Live_BA_mpha_T3-wide_for_dam$Live_BA_mpha_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_prop_dead_slope<-(wide_for_dam$prop_dead_T2-wide_for_dam$prop_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_dead_slope<-(wide_for_dam$prop_dead_T3-wide_for_dam$prop_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_asn_prop_dead_slope<-(wide_for_dam$asn_prop_dead_T2-wide_for_dam$asn_prop_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_asn_prop_dead_slope<-(wide_for_dam$asn_prop_dead_T3-wide_for_dam$asn_prop_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_prop_LRR_dead_slope<-(wide_for_dam$prop_LRR_dead_T2-wide_for_dam$prop_LRR_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_LRR_dead_slope<-(wide_for_dam$prop_LRR_dead_T3-wide_for_dam$prop_LRR_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_asn_prop_LRR_dead_slope<-(wide_for_dam$asn_prop_LRR_dead_T2-wide_for_dam$asn_prop_LRR_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_asn_prop_LRR_dead_slope<-(wide_for_dam$asn_prop_LRR_dead_T3-wide_for_dam$asn_prop_LRR_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_prop_LRRNO_dead_slope<-(wide_for_dam$prop_LRRNO_dead_T2-wide_for_dam$prop_LRRNO_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_LRRNO_dead_slope<-(wide_for_dam$prop_LRRNO_dead_T3-wide_for_dam$prop_LRRNO_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_asn_prop_LRRNO_dead_slope<-(wide_for_dam$asn_prop_LRRNO_dead_T2-wide_for_dam$asn_prop_LRRNO_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_asn_prop_LRRNO_dead_slope<-(wide_for_dam$asn_prop_LRRNO_dead_T3-wide_for_dam$asn_prop_LRRNO_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_prop_SUP_dead_slope<-(wide_for_dam$prop_SUP_dead_T2-wide_for_dam$prop_SUP_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_SUP_dead_slope<-(wide_for_dam$prop_SUP_dead_T3-wide_for_dam$prop_SUP_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_asn_prop_SUP_dead_slope<-(wide_for_dam$asn_prop_SUP_dead_T2-wide_for_dam$asn_prop_SUP_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_asn_prop_SUP_dead_slope<-(wide_for_dam$asn_prop_SUP_dead_T3-wide_for_dam$asn_prop_SUP_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_prop_No_damage_dead_slope<-(wide_for_dam$prop_No_damage_dead_T2-wide_for_dam$prop_No_damage_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_No_damage_dead_slope<-(wide_for_dam$prop_No_damage_dead_T3-wide_for_dam$prop_No_damage_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
wide_for_dam$early_asn_prop_No_damage_dead_slope<-(wide_for_dam$asn_prop_No_damage_dead_T2-wide_for_dam$asn_prop_No_damage_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$late_asn_prop_No_damage_dead_slope<-(wide_for_dam$asn_prop_No_damage_dead_T3-wide_for_dam$asn_prop_No_damage_dead_T2)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T2)
#Descriptive treatments
wide_for_dam$Treatment<-ifelse(wide_for_dam$TRT=="A",
"Red Alder\n12 years",
ifelse(wide_for_dam$TRT=="B",
"Cottonwood\n12 years",
ifelse(wide_for_dam$TRT=="C",
"Douglas fir\nImmediately",
ifelse(wide_for_dam$TRT=="D",
"Red Alder\n25 years","Cottonwood\n25 years" ))))
wide_for_dam$TMT<-ifelse(wide_for_dam$TRT=="A",
"RA 12",
ifelse(wide_for_dam$TRT=="B",
"CW 12",
ifelse(wide_for_dam$TRT=="C",
"DF",
ifelse(wide_for_dam$TRT=="D",
"RA 25","CW 25"))))
wide_for_dam$Treatment<-factor(wide_for_dam$Treatment, levels= c("Douglas fir\nImmediately","Red Alder\n12 years","Cottonwood\n12 years","Red Alder\n25 years","Cottonwood\n25 years"))
wide_for_dam$TMT<-factor(wide_for_dam$TMT, levels= c("DF","RA 12","CW 12","RA 25","CW 25"))
