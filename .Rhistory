install.packages("cowplot")
library(cowplot)
?plot_grid()
output <- plot_grid (BA_TRT_YEAR_plot + theme(legend.position = c(0.15, .95)),QMD_TRT_YEAR_plot+ theme(legend.position = "none"), labels = c('A','B'),  hjust = -3.5, label_size = 20, ncol = 2)
print(output)
pdf(here("Summary_Graphs_update","WC_BA_QMD_plot.pdf"), height= 4.16, width = 15)
print(output)
dev.off()
svg(here("Summary_Graphs_update","WC_BA_QMD_plot.svg"), height= 4.16, width = 15)
print(output)
dev.off()
output <- plot_grid (BA_TRT_YEAR_plot + theme(legend.position = c(0.15, .90)),QMD_TRT_YEAR_plot+ theme(legend.position = "none"), labels = c('A','B'),  hjust = -3.5, label_size = 20, ncol = 2)
