QMD.df<-long_data[,c("TRT","BLOCK","PLOT","Tree_ID_TBP","species_gen","YEAR", "live_DIA","live_BA")]
#remove rows without live diameter measurements
QMD.df<-subset(QMD.df, !is.na(QMD.df$live_BA))
#calculate cumulative sum of live basal areas by TRTxBlock starting with the smallest tree
QMD_stand<- QMD.df %>% group_by(YEAR,TRT,BLOCK) %>% summarise(QMD=sqrt(sum(live_BA)/(n()*0.00007854)),live_BA=sum(live_BA))
QMD_TRT_YEAR<-QMD_stand%>%group_by(TRT, YEAR) %>% summarise(QMD_mean=mean(QMD),SE=(sd(QMD)/sqrt(n())), lower=QMD_mean-SE, upper=QMD_mean+SE,CI=qt(0.975,df=(n()-1))*SE,lower.CI=QMD_mean-CI,upper.CI=QMD_mean+CI,BA_mean=mean(live_BA),BA_SE=(sd(live_BA)/sqrt(n())), lower=BA_mean-BA_SE, upper=BA_mean+BA_SE,BA_CI=qt(0.975,df=(n()-1))*BA_mean,BA_lower.CI=BA_mean-BA_CI,BA_upper.CI=BA_mean+BA_CI)
QMD_TRT_YEAR_plot<-ggplot(QMD_TRT_YEAR,aes(YEAR,QMD_mean))+
geom_point(aes(color=TRT), position=position_dodge(width=0.75))+
geom_errorbar(aes(ymin=lower.CI,ymax=upper.CI, color=TRT),width=0.25, position=position_dodge(width=0.75))+
labs(y='Stand Mean (+/- 95% CI) Quadratic Mean Diameter (cm)')+
geom_line(aes(color=TRT))+
scale_color_manual(values = WC_palette)+
scale_x_continuous(breaks=c(1990,1995,2000,2009,2020))+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(), legend.position = "left")
QMD_TRT_YEAR_plot
BA_TRT_YEAR_plot<-ggplot(QMD_TRT_YEAR,aes(YEAR,BA_mean))+
geom_point(aes(color=TRT), position=position_dodge(width=0.75))+
geom_errorbar(aes(ymin=BA_lower.CI,ymax=BA_upper.CI, color=TRT),width=0.25, position=position_dodge(width=0.75))+
labs(y=bquote('Stand Mean (+/-SE) Basal Area '(m^2~ha^-1)))+
geom_line(aes(color=TRT))+
scale_color_manual(values = WC_palette)+
scale_x_continuous(breaks=c(1990,1995,2000,2009,2020))+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(), legend.position = "left")
