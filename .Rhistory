#import the recorded trees relative to compass points
cut_tree_df<-read_excel(here("Poria_survey_70s.xlsx"), sheet = "Cut_stump_trees", range = "A1:G179", col_names = TRUE)
#compass_test<-por_compass_df[c(1:4, 35:37),]
#Adding Block compass points for Poria survey
#making smaller df with relevant info
cut_comp_loc<-cut_compass_df[,c("Block","loc_X_1","loc_Y_1")]
#merge(dat1, dat2, by.x = 2, by.y = 0, all.x = TRUE)
cut_tree_w_ref<-merge(cut_tree_df, cut_comp_loc, by.x = "Block", by.y = "Block", all.x = TRUE)
#adjust N to grid Y positive
cut_tree_w_ref$Azimuth_flip <-cut_tree_w_ref$Azimuth +135
#polar to cartesian
cut_tree_w_ref$loc_X <- cut_tree_w_ref$loc_X_1+cut_tree_w_ref$Dist*sin(cut_tree_w_ref$Azimuth_flip*pi/180)
cut_tree_w_ref$loc_Y <- cut_tree_w_ref$loc_Y_1+cut_tree_w_ref$Dist*cos(cut_tree_w_ref$Azimuth_flip*pi/180)
plot(por_compass_df$ft_X_1,por_compass_df$ft_Y_1,xlim=c(0,1800),ylim=c(0,1800))
points(cut_compass_df$loc_X_1,cut_compass_df$loc_Y_1,col="blue", cex=2)
points(cut_tree_w_ref$loc_X,cut_tree_w_ref$loc_Y, col="black")
cut_tree_w_ref$Age_class<-"Live, cut stump detection"
cut_tree_w_ref_merge<-cut_tree_w_ref[,c("Block","Species","Age_class","loc_X","loc_Y","Diameter")]
colnames(cut_tree_w_ref_merge)<-c("Block","Species","Age_class","loc_X","loc_Y","Diameter")
por_tree_w_ref_merge<-por_tree_w_ref[,c("Block","Species","Age_class","loc_X","loc_Y","Diameter (in)")]
colnames(por_tree_w_ref_merge)<-c("Block","Species","Age_class","loc_X","loc_Y","Diameter")
por_and_cut<-rbind(por_tree_w_ref_merge, cut_tree_w_ref_merge)
por_and_cut$Age_class<-factor(por_and_cut$Age_class, levels=c("Live, cut stump detection","Live with Symptoms","Dead <10 years","Dead >10 years"), ordered = TRUE)
#import tree locations derived from image_J map
#  IJ_stumps<-read_excel("C:/Users/showalt_d/Documents/GitHub/Apiary_LRR/Poria_survey_70s.xlsx", sheet = "Image_J_cut_stump", range = "A1:L73", col_names = TRUE)
IJ_stumps<-read_excel(here("Poria_survey_70s.xlsx"), sheet = "Image_J_cut_stump", range = "A1:L73", col_names = TRUE)
IJ_stumps$ref_X_ft<-IJ_stumps$ref_x*132
IJ_stumps$ref_Y_ft<-IJ_stumps$ref_y*132
#adjust N to grid Y positive
IJ_stumps$Azi_flip <-IJ_stumps$azi +135
#polar to cartesian
IJ_stumps$loc_X <- IJ_stumps$ref_X_ft+IJ_stumps$ft*sin(IJ_stumps$Azi_flip*pi/180)
IJ_stumps$loc_Y <- IJ_stumps$ref_Y_ft+IJ_stumps$ft*cos(IJ_stumps$Azi_flip*pi/180)
IJ_stumps$Age_class<-"Live, cut stump detection"
IJ_stumps$Species<-"DF"
IJ_stumps_merge<-IJ_stumps[,c("Block","Species","Age_class","loc_X","loc_Y")]
#impute diameters for image J trees based on nearest plot with data
cut_diameters<-as.vector(cut_tree_w_ref[['Diameter']])
IJ_stumps_merge$Diameter<-sample(cut_diameters, 72, replace = TRUE)
por_and_cut_IJ<-rbind(por_and_cut, IJ_stumps_merge)
por_and_cut_IJ$Age_class<-factor(por_and_cut_IJ$Age_class, levels=c("Live, cut stump detection","Live with Symptoms","Dead <10 years","Dead >10 years"), ordered = TRUE)
