long_data<- pivot_longer(full_data, cols = c("DIA_87_mm","DIA_95_mm","DBH_11","NDBH"), names_to = "YEAR", values_to = "DBH_mm")
#for status
status<-pivot_longer(full_data, cols = c("STS_87","STS_95","STS_2011","NSTS"), names_to = "YEAR", values_to = "STATUS")
#for 2011 and 2020 damage codes with dummy variables for 87 95 because the status was not recorded in those years
full_data$DAM87<-NA
full_data$DAM95<-NA
damage<-pivot_longer(full_data, cols = c("DAM87","DAM95","DAM1.x","DAM1.y"), names_to = "YEAR", values_to = "DAM")
#combining
long_data$STATUS<-as.character(status$STATUS)
#long_data$HEIGHT<-as.character(height$HEIGHT)
long_data$DAMAGE<-as.character(damage$DAM)
#replacing numbers for "YEAR" and also adding a "YEAR" factor variable
long_data$YEAR_dbl<-as.double(ifelse(long_data$YEAR=="DIA_87_mm", 1987,
ifelse(long_data$YEAR=="DIA_95_mm", 1995,
ifelse(long_data$YEAR=="DBH_11", 2011,
ifelse(long_data$YEAR=="NDBH", 2020, NA)))))
long_data$YEAR_fac<-as.factor(long_data$YEAR_dbl)
#making descriptive status variable
long_data$Tree_status<-as.character(ifelse(long_data$STATUS=="1", "Alive",
ifelse(long_data$STATUS=="3", "Dead", NA)))
#and a suppression flag
long_data$SUPP<-ifelse((long_data$STATUS=="3"|long_data$STATUS=="1"), (ifelse(long_data$DAMAGE=="400", "Suppressed", "Not")), NA)
#combined suppressin and status
long_data$SUP_MORT<- as.character(paste0(long_data$SUPP,long_data$Tree_status,sep=""))
#and a root rot flag
long_data$ROOT<-as.character(ifelse((long_data$DAMAGE=="806"|long_data$DAMAGE=="807"|long_data$DAMAGE=="808"), "ROT", NA))
long_data$PW_R<-as.character(ifelse((long_data$DAMAGE=="806"|long_data$DAMAGE=="807"), 1, NA))
long_data$PW<-as.character(ifelse((long_data$DAMAGE=="807"), 1, NA))
#adding nominal diameter to small trees too short to have a diameter at breast height
long_data$DBH_mm_nom<-ifelse(long_data$YEAR_dbl==1995& long_data$STATUS=="1" & long_data$HT_95<5 & is.na(long_data$DBH_mm)==TRUE & is.na(long_data$HT_95)==FALSE
,2.5
,long_data$DBH_mm)
#making live basal area calculation for each tree using status and diameter
long_data$DBH_cm<-ifelse(long_data$STATUS=="1",long_data$DBH_mm_nom/10 , NA)
long_data$Live_BA_sq_m<-as.double(ifelse(long_data$STATUS=="1", (3.14159*(long_data$DBH_cm^2)/40000), NA))
#creating DF_age variable based on treatment and estimated measurement year
long_data$DF_age<-NA
long_data$DF_age<-as.numeric(
ifelse( long_data$YEAR=="NDBH" #test 2020
, #yes 2020
ifelse((long_data$TRT=="RA20Y" | long_data$TRT=="CW20Y") #test 20Y
, 20  #yes 20Y
, #no 20Y
ifelse((long_data$TRT=="RA10Y" | long_data$TRT=="CW10Y") #test 10y
, 33  #yes 10Y
, 45 #no 10Y
)# TRT 10 test close
) #TRT 20 test Close
, #no 2020
ifelse( long_data$YEAR=="DBH_11",  #test 2011
ifelse( #yes 2011
(long_data$TRT=="RA20Y" | long_data$TRT=="CW20Y"), # test 20Y
11 #yes 20y
, #no 20 y
ifelse((long_data$TRT=="RA10Y" | long_data$TRT=="CW10Y"), #test 10y
24, #yes 10y
36) #no 10Y therefore DF
) #close 20y test
, #no 2011
ifelse(long_data$YEAR=="DIA_95_mm", #test 95
ifelse( #yes 95
(long_data$TRT=="RA10Y" | long_data$TRT=="CW10Y"), #test 10YTRT
8, #yes 10Y TRT
NA #no 10Y TRT (and therefore not sampled in 1995)
)   #close TRT test
, #no 95
ifelse(long_data$YEAR=="DIA_87_mm", #test 87
ifelse( #yes 87
long_data$TRT=="DF0Y", #test DF
12, #yes DF
NA), #no DF (and therefore no to all treatments)
NA #no 87 (and therefor no to all dates)
) # 87 close
) # 95 close
) # 11 close
) # 2020 close
) #numeric close
long_data$FVS_age<-NA
long_data$FVS_age<-ifelse(long_data$DF_age==12,0,
ifelse(long_data$DF_age==8,0,
ifelse(long_data$DF_age==24,16,
ifelse(long_data$DF_age==33,25,
ifelse(long_data$DF_age==36,24,
ifelse(long_data$DF_age==45,35,
ifelse(long_data$DF_age==11,0,
ifelse(long_data$DF_age==20,9,
NA))))))))
#subsetting to keep only relevant columns
keep_cols<- c("Tree_ID","TREE","PLOT","REP","SUBPLOT","SUBPLOT_ID","TRT","TRT_code","YEAR_fac","YEAR_dbl","DF_age","Tree_status","DBH_mm","Live_BA_sq_m","STATUS","DAMAGE", "SUPP", "ROOT","PW","PW_R","FVS_age","SUP_MORT","DBH_mm_nom")
long_data_keep<-long_data[,names(long_data) %in% keep_cols]
long_data_keep<-long_data_keep[,keep_cols]
#dropping A3 and A1 plots due to missed harvest or missed red alder suppression
#RACW10<-subset(long_data_keep, (TRT=="RA10Y" |TRT=="CW10Y"))
lessA1A3<-subset(long_data_keep, (TRT!="RA10Y" |SUBPLOT_ID=="A01" |SUBPLOT_ID=="A02"|SUBPLOT_ID=="A03"|SUBPLOT_ID=="A04"|SUBPLOT_ID=="A05"|SUBPLOT_ID=="A21"|SUBPLOT_ID=="A22"|SUBPLOT_ID=="A23"|SUBPLOT_ID=="A24"|SUBPLOT_ID=="A25"|SUBPLOT_ID=="A41"|SUBPLOT_ID=="A42"|SUBPLOT_ID=="A43"|SUBPLOT_ID=="A44"|SUBPLOT_ID=="A45"))
#ABC_long_keep<-long_data_keep[long_data_keep$TRT_code=="A"|long_data_keep$TRT_code=="B"|long_data_keep$TRT_code=="C",]
#write.csv(long_data_keep, file="C:/Users/showa/Documents/GitHub/Apiary_LRR/raw_data/long_data_keep.csv", row.names = FALSE)
#write.csv(lessA1A3, file="C:/Users/showa/Documents/GitHub/Apiary_LRR/raw_data/long_data_keep_lessA1A3.csv", row.names = FALSE)
#saveRDS(long_data_keep, file="C:/Users/showa/Documents/GitHub/Apiary_LRR/raw_data/long_data_keep.Rds")
#saveRDS(lessA1A3, file="C:/Users/showa/Documents/GitHub/Apiary_LRR/raw_data/long_data_keep_lessA1A3.Rds")
#subset by treatments and treatments with similar ages
RACW10<-subset(lessA1A3, (TRT=="RA10Y" |TRT=="CW10Y"))
RACW20<-subset(lessA1A3, (TRT=="RA20Y" |TRT=="CW20Y"))
RA10<-subset(lessA1A3, TRT=="RA10Y")
CW10<-subset(lessA1A3, TRT=="CW10Y")
DF0<-subset(lessA1A3, TRT=="DF0Y")
CW20<-subset(lessA1A3, TRT=="CW20Y")
RA20<-subset(lessA1A3, TRT=="RA20Y")
#for ABC dataset
#RACW10_ABC<-subset(ABC_long_keep, (TRT=="RA10Y" |TRT=="CW10Y"))
#RA10_ABC<-subset(ABC_long_keep, TRT=="RA10Y")
#CW10_ABC<-subset(ABC_long_keep, TRT=="CW10Y")
#DF0_ABC<-subset(ABC_long_keep, TRT=="DF0Y")
#make varible containing total counts of trees with diameters
median_dbh_Alive<-subset(lessA1A3, Tree_status=="Alive") %>%
group_by(DF_age, TRT, Tree_status) %>%
summarise(Median=round(median(DBH_mm, na.rm=TRUE)), N=n())
median_dbh_Dead<-subset(lessA1A3, Tree_status=="Dead") %>%
group_by(DF_age, TRT, Tree_status) %>%
summarise(Median=round(median(DBH_mm, na.rm=TRUE)), N=n())
pall<- subset(lessA1A3, !is.na(Tree_status)) %>%
ggplot(aes(DBH_mm,fill=Tree_status))+
geom_histogram(position="identity", alpha=0.65, binwidth =25)+
scale_fill_viridis_d(begin = 0.33, end = 0.99)+
labs(title= "Size distrubtion of trees by Age and Treatment",x="DBH (mm)",y= "Trees") +
geom_label(data = median_dbh_Alive,aes(x=Median+200,y=88,label=paste0("Sum: \n",N,"\n Median: \n",Median,"mm"), alpha=0.05),  show.legend = FALSE, label.size = 0)+
geom_label(data = median_dbh_Dead,aes(x=55,y=88, label=paste0("Sum: \n",N,"\n Median: \n",Median,"mm"), fontface='italic', alpha=0.05), show.legend = FALSE, label.size = 0)+
geom_vline(data=median_dbh_Dead,aes(xintercept=Median), linetype=2, alpha=0.5)+
geom_vline(data=median_dbh_Alive,aes(xintercept=Median), alpha=0.5)+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
facet_grid(rows=vars(DF_age),vars(TRT), labeller = label_both)+
scale_y_continuous(breaks = c(0,20,40,60,80,100),limits=c(0,100))+
xlim(0,600)+
theme_bw()
pall
