geom_label(data = medCW10_1Dead,aes(x=55,y=25, label=paste0("Sum: \n",N,"\n Median: \n",Median,"mm"), fontface='italic', alpha=0.05), show.legend = FALSE, label.size = 0)+
geom_vline(data=medCW10_1Dead,aes(xintercept=Median), linetype=2, alpha=0.5)+
geom_vline(data=medCW10_1Alive,aes(xintercept=Median), alpha=0.5)+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
facet_grid(rows=vars(DF_age),vars(SUBPLOT), labeller = label_both)+
ylim(0,30)+
xlim(0,600)+
theme_bw()
