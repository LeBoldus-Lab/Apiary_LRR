#plotting4
medDF0_4Alive<-subset(DF0_R4, Tree_status=="Alive") %>%
group_by(DF_age, SUBPLOT, Tree_status) %>%
summarise(Median=round(median(DBH_mm, na.rm=TRUE)), N=n())
medDF0_4Dead<-subset(DF0_R4, Tree_status=="Dead") %>%
group_by(DF_age, SUBPLOT, Tree_status) %>%
summarise(Median=round(median(DBH_mm, na.rm=TRUE)), N=n())
pDF0_4<- subset(DF0_R4, !is.na(Tree_status)) %>%
ggplot(aes(DBH_mm,fill=Tree_status))+
geom_histogram(position="identity", alpha=0.65, binwidth=25, )+
scale_fill_viridis_d(begin = 0.33, end = 0.99)+
labs(title= "Size distrubtion of trees in DF0 Rep 4 by Age and Subplot",x="DBH (mm)",y= "Trees") +
geom_label(data = medDF0_4Alive,aes(x=Median+200,y=25,label=paste0("Sum: \n",N,"\n Median: \n",Median,"mm"), alpha=0.05),  show.legend = FALSE, label.size = 0)+
geom_label(data = medDF0_4Dead,aes(x=55,y=25, label=paste0("Sum: \n",N,"\n Median: \n",Median,"mm"), fontface='italic', alpha=0.05), show.legend = FALSE, label.size = 0)+
geom_vline(data=medDF0_4Dead,aes(xintercept=Median), linetype=2, alpha=0.5)+
geom_vline(data=medDF0_4Alive,aes(xintercept=Median), alpha=0.5)+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
facet_grid(rows=vars(DF_age),vars(SUBPLOT), labeller = label_both)+
ylim(0,30)+
xlim(0,600)+
theme_bw()
pDF0_4
