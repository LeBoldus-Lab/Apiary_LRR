STAND_ID<-c(unique(FVS_TreeInit_Input$STAND_ID))
Stand_prep<-as.data.frame(STAND_ID)
FVS_StandInit_Input = data.frame(matrix(nrow = nrow(Stand_prep), ncol = ncol(FVS_StandInit)))
colnames(FVS_StandInit_Input) = colnames(FVS_StandInit)
FVS_StandInit_Input$STAND_CN<-Stand_prep$STAND_ID
FVS_StandInit_Input$STAND_ID<-Stand_prep$STAND_ID
