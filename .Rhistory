FVS_TreeInit_Test2$STAND_CN<-FVS_Stump_Prep$StandNum
FVS_TreeInit_Test2$STAND_CN <- sprintf("%02d",FVS_TreeInit_Test2$STAND_CN) # fix to 2 characters
FVS_TreeInit_Test2$STAND_ID<-FVS_Stump_Prep$StandNum
FVS_TreeInit_Test2$STAND_ID <- sprintf("%02d",FVS_TreeInit_Test2$STAND_ID) # fix to 2 characters
FVS_TreeInit_Test2$PLOT_ID<-FVS_Stump_Prep$PlotNum
FVS_TreeInit_Test2$PLOT_ID <- sprintf("%03d",FVS_TreeInit_Test2$PLOT_ID) # fix to 3 characters
FVS_TreeInit_Test2$PLOT_CN<-FVS_Stump_Prep$PlotNum
FVS_TreeInit_Test2$PLOT_CN <- sprintf("%03d",FVS_TreeInit_Test2$PLOT_CN) # fix to 3 characters
FVS_TreeInit_Test2$STANDPLOT_CN<-paste0(FVS_TreeInit_Test2$STAND_CN,FVS_TreeInit_Test2$PLOT_CN)
FVS_TreeInit_Test2$STANDPLOT_CN <- sprintf("%05s",FVS_TreeInit_Test2$STANDPLOT_CN) # fix to 5 characters
FVS_TreeInit_Test2$STANDPLOT_ID<-paste0(FVS_TreeInit_Test2$STAND_ID,FVS_TreeInit_Test2$PLOT_ID)
FVS_TreeInit_Test2$STANDPLOT_ID <- sprintf("%05s",FVS_TreeInit_Test2$STANDPLOT_ID) # fix to 5 characters
FVS_TreeInit_Test2$TREE_ID<-FVS_Stump_Prep$entry
FVS_TreeInit_Test2$HISTORY<-7
FVS_TreeInit_Test2$DIAMETER<-(FVS_Stump_Prep$DIAMETER)
FVS_TreeInit_Test2$SPECIES<-FVS_Stump_Prep$SPECIES
FVS_TreeInit_Test2$VARIANT<-"pn"
#add stumps to seedlings input
FVS_TreeInit_Input<-rbind(FVS_TreeInit_Test,FVS_TreeInit_Test2)
FVS_TreeInit_Input$SITE_TREE_FLAG<-0
#GENERATE PLOT INPUTS
STANDPLOT_ID<-c(unique(FVS_TreeInit_Input$STANDPLOT_ID))
Plot_prep<-as.data.frame(STANDPLOT_ID)
colnames(Plot_prep)<-"STANDPLOT_ID"
#split subplot ID to get TRT BLOCK and SUBPLOP IDS
df<-data.frame(str_split_fixed(Plot_prep$STANDPLOT_ID, "", 5))
df$STAND_ID<-paste(df$X1,df$X2,sep="")
df$PLOT_ID<-paste(df$X3,df$X4,df$X5,sep ="")
FVS_Plot_Prep<-cbind(Plot_prep,df)
#create an input file based on template and input data
FVS_PlotInit_Input = data.frame(matrix(nrow = nrow(FVS_Plot_Prep), ncol = ncol(FVS_PlotInit)))
# assign column names
colnames(FVS_PlotInit_Input) = colnames(FVS_PlotInit)
FVS_PlotInit_Input$STANDPLOT_CN<-FVS_Plot_Prep$STANDPLOT_ID
FVS_PlotInit_Input$STANDPLOT_ID<-FVS_Plot_Prep$STANDPLOT_ID
FVS_PlotInit_Input$PLOT_CN<-FVS_Plot_Prep$PLOT_ID
FVS_PlotInit_Input$PLOT_ID<-FVS_Plot_Prep$PLOT_ID
FVS_PlotInit_Input$STAND_ID<-FVS_Plot_Prep$STAND_ID
FVS_PlotInit_Input$STAND_CN<-FVS_Plot_Prep$STAND_ID
FVS_PlotInit_Input$INV_PLOT_SIZE=20
FVS_PlotInit_Input$BRK_DBH=999
FVS_PlotInit_Input$VARIANT<-"pn"
FVS_PlotInit_Input$REGION=6
FVS_PlotInit_Input$FOREST=12
FVS_PlotInit_Input$AGE=0
