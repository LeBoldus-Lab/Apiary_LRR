labs(title="Early" ,x="",y=bquote('Stand Mean (+/-95%CI) Annual Live BA Increment  '(m^2~ha^-1~year^-1)))+
scale_fill_manual(values=trt_colors[c(1,2,4,5)])+
geom_text(aes(label=tukey,y= early_BA_means_CI$upper+0.1),show.legend = FALSE)+
theme_bw()+
