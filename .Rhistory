confint(BAFmodel)
confint(BAFmodel.em)
early_BA_means_CI<-confint(BAFmodel.em)
early_BA_means_CI$TRT<-rownames(early_BA_means_CI)
early_BA_means_CI<-early_BA_means_CI %>%
mutate(TRT = str_replace(TRT, "TMT", ""))
early_BA_means_CI$TRT<-as.factor(c("RA 12Y", "CW 12Y","RA 25Y","CW 25Y"))
early_BA_means_CI$TRT<- ordered(early_BA_means$TRT, levels = c("RA 12Y","CW 12Y","RA 25Y","CW 25Y"))
#adding posthoc results
early_BA_mean_CIs$tukey<-c("ab","a","a","b")
early_BA_means_CI$TRT<-rownames(early_BA_means_CI)
early_BA_means_CI<-early_BA_means_CI %>%
