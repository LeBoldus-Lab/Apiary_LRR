por_tree_w_ref$loc_Y <- por_tree_w_ref$ft_Y_ave+por_tree_w_ref$Dist*cos(por_tree_w_ref$Azimuth_flip*pi/180)
plot(por_compass_df$ft_X_1,por_compass_df$ft_Y_1,xlim=c(0,1800),ylim=c(0,1800))
points(por_compass_df$ft_X_ave,por_compass_df$ft_Y_ave,col="blue", cex=2)
points(por_tree_w_ref$loc_X,por_tree_w_ref$loc_Y, col="black")
#make more informative mortality names.
por_tree_w_ref$Age_class<-ifelse(por_tree_w_ref$Age_class=="A", "Live with Symptoms",
ifelse(por_tree_w_ref$Age_class=="B", "Dead <10 years",
ifelse(por_tree_w_ref$Age_class=="C", "Dead >10 years", NA)))
por_tree_w_ref$Age_class<-factor(por_tree_w_ref$Age_class, levels=c("Dead >10 years","Dead <10 years","Live with Symptoms"), ordered = TRUE)
p <- ggplot() +
geom_label(data=subplot_df, x=subplot_df$loc_X_final, y= subplot_df$loc_Y_final,label= subplot_df$subplot, label.size = NA, size=3, alpha=0.5)+
scale_x_continuous("Grid ft NW",breaks = seq(0,1716,132))+
scale_y_continuous("Grid ft SW",breaks = seq(0,1452,132))+
theme_bw()+
theme(panel.grid.major = element_line(colour="black", size=0.5))+
geom_circle(data=subplot_df,aes(x0 = subplot_df$loc_X_final, y0 = subplot_df$loc_Y_final, r = 26.3))
incidence<-p + geom_point(aes(x=por_tree_w_ref$loc_X,y=por_tree_w_ref$loc_Y, shape=por_tree_w_ref$Age_class, ), alpha=0.6)+ labs(shape = "Pre-harvest\nLRR Incidence")+ scale_shape_discrete(na.translate = F)
