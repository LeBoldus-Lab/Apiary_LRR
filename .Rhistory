df_trt_fit <- survfit(Surv(time, status) ~ Cond_flag, data = dfsurv)
summary(df_trt_fit, times = c(5*(1:9)))
autoplot(df_trt_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in Continuous Rotation")
