#out of curiosity, group by REP
growth_test_rep<-growth_test %>% filter(!is.na(growth_test$DF_age))
dbh_plot_rep<-ggplot(growth_test_rep,aes(DF_age,live_DBH_cm,colour=factor(REP)))+geom_path(group=growth_test_rep$Tree_ID, alpha=0.1, na.rm = TRUE)+theme_bw()+geom_smooth(method = lm)+scale_color_viridis_d()
dbh_plot_rep
growth_test_mid<-growth_test2 %>% filter(growth_test2$DF_age==8|growth_test2$DF_age==12|growth_test2$DF_age==33|growth_test2$DF_age==36)
dbh_plot_mid_rep<-ggplot(growth_test_mid,aes(DF_age,live_DBH_cm,colour=Cond_flag,fill=Cond_flag,linetype=Cond_flag))+geom_path(group=growth_test_mid$Tree_ID, alpha=0.3, show.legend = FALSE)+theme_bw()+geom_smooth(method = lm) +facet_grid(rows=vars(growth_test_mid$REP),cols=vars(growth_test_mid$TRT)) +scale_color_viridis_d()+scale_fill_viridis_d()
dbh_plot_mid_rep
svg(here("Summary_Graphs_update","mid_growth_by_LRR_SUPP_NOT.svg"), height= 6, width = 6)
dbh_plot_mid
