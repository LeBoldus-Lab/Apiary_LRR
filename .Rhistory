wide_stand_stats$Treatment<-ifelse(wide_stand_stats$TRT=="A",
"Red Alder\n12 years",
ifelse(wide_stand_stats$TRT=="B",
"Cottonwood\n12 years",
ifelse(wide_stand_stats$TRT=="C",
"Douglas fir\nImmediately",
ifelse(wide_stand_stats$TRT=="D",
"Red Alder\n25 years","Cottonwood\n25 years" ))))
