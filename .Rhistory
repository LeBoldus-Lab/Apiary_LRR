CW10_ABC<-subset(ABC_long_keep, TRT=="CW10Y")
DF0_ABC<-subset(ABC_long_keep, TRT=="DF0Y")
Labels_ALIVE <- subset(RA10, ALIVE=="ALIVE") %>% group_by(DF_age, REP, ALIVE) %>% summarise(N=paste0('Alive: ',n()))
Labels_DEAD <- subset(RA10, ALIVE=="DEAD") %>% group_by(DF_age, REP, ALIVE) %>% summarise(N=paste0('Dead: ',n()))
#X position using dummy value
Labels_ALIVE$DBH_mm <- 300
Labels_DEAD$DBH_mm <- 300
median_dbh_ALIVE<-subset(RA10, ALIVE=="ALIVE") %>% group_by(DF_age, REP, ALIVE) %>% summarise(Median=median(DBH_mm))
median_dbh_DEAD<-subset(RA10, ALIVE=="DEAD") %>% group_by(DF_age, REP, ALIVE) %>% summarise(Median=median(DBH_mm))
pRA10<-ggplot(data=subset(RA10, !is.na(ALIVE)) ,aes(DBH_mm,fill=ALIVE))+
geom_histogram(position="stack", bins=20)+scale_fill_viridis_d(begin = 0.3, end = 0.9)+
labs(title= "Size distrubtion of trees in RA10 Treatment by Age and Rep",x="DBH (mm)",y= "Trees") +
geom_text(data = Labels_ALIVE,aes(x=DBH_mm,y=70,label=N))+
geom_text(data = Labels_DEAD,aes(x=DBH_mm,y=60,label=N))+
geom_vline(data=median_dbh_DEAD,aes(xintercept=Median), linetype=2)+
geom_vline(data=median_dbh_ALIVE,aes(xintercept=Median))+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
facet_grid(rows=vars(DF_age),vars(REP), labeller = label_both)
pRA10
