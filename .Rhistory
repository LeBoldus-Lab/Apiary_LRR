EMaF<-lmer(early_asn_prop_dead_slope ~ TMT , data = trimE1, REML=FALSE, verbose = 2)
EMaF<-lm(early_asn_prop_dead_slope ~ TMT , data = trimE1)
plot(EMaF, type = c("p", "smooth"))
plot(EMaF)
plot(EMaF, sqrt(abs(resid(.))) ~ fitted(.))
lattice::qqmath(EMaF, id = 0.05)
summary(EMaF)
anova(EMaF)
VarCorr(EMaF)
summary(EMaF)
anova(EMaF)
ls_means(EMaF)
emmeans(EMaF)
EMaF.rg1<-ref_grid(EMaF)
EMaF.rg1
summary(EMaF.rg1)
elsm<-summary(EMaF.rg1)
#backtransform mortality estimates for reporting
elsm$backtran<-(sin(elsm$prediction))^2
elsm$backtran_se<-(sin(elsm$SE))^2
View(elsm)
