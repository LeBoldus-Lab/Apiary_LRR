QMD_1990_95CI$year<-"1990"
QMD_2020_95CI$year<-"2020"
QMD_combined<-rbind(QMD_1990_95CI,QMD_2020_95CI)
QMD_combined_plot<-ggplot(QMD_combined,aes(year,QMD_mean))+
geom_point(aes(color=TRT))+
geom_errorbar(aes(ymin=lower.CI,ymax=upper.CI, color=TRT),width=0.2)+
labs(y='Stand Quadratic Mean (+/- 95% CI) Diameter (cm)')+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(),legend.position = "none")
QMD_combined_plot
QMD_combined_plot<-ggplot(QMD_combined,aes(year,QMD_mean))+
geom_point(aes(color=TRT), position_dodge())+
geom_errorbar(aes(ymin=lower.CI,ymax=upper.CI, color=TRT),width=0.2, position_dodge())+
labs(y='Stand Quadratic Mean (+/- 95% CI) Diameter (cm)')+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(),legend.position = "none")
