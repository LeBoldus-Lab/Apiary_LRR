#early mort slope
# define model
add_emorto_model <- lm(early_mort_slope ~ TMT+ordered(Block), data = wide_stand_stats)
# Change the panel layout to 2 x 2 (to look at all 4 plots at once)
hist(add_emorto_model$residuals)
par(mfrow = c(2, 2))
# Use plot() function to create diagnostic plots
plot(add_emorto_model)
summary(add_emorto_model)
aov.add_emorto<-aov(add_emorto_model)
summary(aov.add_emorto)
add_emortf_model <- lm(early_mort_slope ~ TMT+factor(Block), data = wide_stand_stats)
# Change the panel layout to 2 x 2 (to look at all 4 plots at once)
hist(add_emortf_model$residuals)
par(mfrow = c(2, 2))
# Use plot() function to create diagnostic plots
plot(add_emortf_model)
summary(add_emortf_model)
aov.add_emortf<-aov(add_emortf_model)
summary(aov.add_emortf)
#trying rank transformation prior to ANOVA
#https://rcompanion.org/handbook/F_16.html
#model = art(early_mort_slope ~ TMT + factor(Block) + TMT:factor(Block) ,data = wide_stand_stats)
#anova(model)
#received 0 degrees of freedom error
#alternative would be to create a combined TMTxBlock variable and run a Kruskal Wallis test
wide_stand_stats$TxB<-paste(wide_stand_stats$TRT, wide_stand_stats$Block, Sep="")
kwem<-kruskal.test(early_mort_slope ~ TxB, data = wide_stand_stats)
kwem
pwem<-pairwise.wilcox.test(wide_stand_stats$early_mort_slope, wide_stand_stats$TxB,
p.adjust.method = "BH")
pwem
#late mort slope
# define model
add_lmorto_model <- lm(late_mort_slope ~ TMT+ordered(Block), data = wide_stand_stats)
# Change the panel layout to 2 x 2 (to look at all 4 plots at once)
hist(add_lmorto_model$residuals)
par(mfrow = c(2, 2))
# Use plot() function to create diagnostic plots
plot(add_lmorto_model)
summary(add_lmorto_model)
aov.add_lmorto<-aov(add_lmorto_model)
summary(aov.add_lmorto)
add_lmortf_model <- lm(late_mort_slope ~ TMT+factor(Block), data = wide_stand_stats)
# Change the panel layout to 2 x 2 (to look at all 4 plots at once)
hist(add_lmortf_model$residuals)
par(mfrow = c(2, 2))
# Use plot() function to create diagnostic plots
plot(add_lmortf_model)
summary(add_lmortf_model)
aov.add_lmortf<-aov(add_lmortf_model)
summary(aov.add_lmortf)
#alternative would be to create a combined TMTxBlock variable and run a Kruskal Wallis test
#wide_stand_stats$TxB<-paste(wide_stand_stats$TRT, wide_stand_stats$Block, Sep="")
kwlm<-kruskal.test(late_mort_slope ~ TxB, data = wide_stand_stats)
kwlm
wide_stand_stats_ABC<- subset(wide_stand_stats, wide_stand_stats$TRT!="D"&wide_stand_stats$TRT!="E")
pwlm<-pairwise.wilcox.test(wide_stand_stats_ABC$late_mort_slope, wide_stand_stats_ABC$TxB,
p.adjust.method = "BH")
pwlm
#just treatment effect
tkwlm<-kruskal.test(late_mort_slope ~ TRT, data = wide_stand_stats)
tkwlm
wide_stand_stats_ABC<- subset(wide_stand_stats, wide_stand_stats$TRT!="D"&wide_stand_stats$TRT!="E")
tpwlm<-pairwise.wilcox.test(wide_stand_stats_ABC$late_mort_slope, wide_stand_stats_ABC$TRT,
p.adjust.method = "BH")
tpwlm
#just Block effect
bkwlm<-kruskal.test(late_mort_slope ~ Block, data = wide_stand_stats)
bkwlm
wide_stand_stats_ABC<- subset(wide_stand_stats, wide_stand_stats$TRT!="D"&wide_stand_stats$TRT!="E")
bpwlm<-pairwise.wilcox.test(wide_stand_stats_ABC$late_mort_slope, wide_stand_stats_ABC$Block,
p.adjust.method = "BH")
bpwlm
