library(survival)
library(ranger)
library(ggfortify)
#select relevant columns from tree-level wide data set
survival_keep<-c("Tree_ID","REP","TRT_code","DEAD_YEAR","STS_2011","NSTS")
survival_data<-as.data.frame(full_data[,(colnames(full_data) %in% survival_keep)])
#remove reps 1 and 3 from RA12
survival_data<-survival_data[-(which(survival_data$TRT_code=="A"& survival_data$REP=="1")),]
survival_data<-survival_data[-(which(survival_data$TRT_code=="A"& survival_data$REP=="3")),]
#assign status=0 for trees that were alive in 2020 and status=1 to trees that died during the study
survival_data$status<-ifelse(survival_data$NSTS=="1",0,1)
#use combination of TRT_code, NSTS, and DEAD_year to calculate "survival time" for each tree.
#to simplify calculating survival time, start with assigning a start year for each treatment
survival_data$begin<-ifelse(survival_data$TRT_code=="A"|survival_data$TRT_code=="B",
1987,
ifelse(survival_data$TRT_code=="C",
1975, 2000))
survival_data$time<-ifelse(survival_data$status==0, #if tree is alive in 2020
(2020-survival_data$begin), #subtract begin from 2020
ifelse(survival_data$STS_2011=="1", # if tree is alive in 2011
(2020-survival_data$begin), #then subtract begin from 2020
(survival_data$DEAD_YEAR- survival_data$begin) #if not, then subtract begin from DEAD_YEAR
)
)
#use "LRR_list" and "SUP_list" to add grouping flags to trees. From lines 2808 and 2810
survival_data$Cond_flag<-    ifelse(survival_data$Tree_ID %in% LRR_list, # test LRR
"LRR", #if so, print LRR
ifelse(survival_data$Tree_ID %in% SUP_list,#if not, test SUPP
"SUP", #if so, print SUP
"NONE")) #if not, print NONE
#now try making survival object and Kaplan-Meier estimates
km<-Surv(survival_data$time, survival_data$status)
km_fit <- survfit(Surv(survival_data$time, survival_data$status) ~ 1)
summary(km_fit, times = c(5*(1:9)))
pkm<-autoplot(km_fit, xlim=c(0,50))
pkm
#split by condition flag
km_cond_fit <- survfit(Surv(time, status) ~ Cond_flag, data = survival_data)
summary(km_cond_fit, times = c(5*(1:9)))
pkmc<-autoplot(km_cond_fit, xlim=c(0,50),xlab = "Years")
pkmc
#rerunning with just DF treatment
dfsurv<-survival_data[which(survival_data$TRT_code=="C"),]
#split by condition flag
df_fit <- survfit(Surv(time, status) ~ 1, data = dfsurv)
p0<-autoplot(df_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in Continuous Rotation")
df_cond_fit <- survfit(Surv(time, status) ~ Cond_flag, data = dfsurv)
p0
summary(df_cond_fit, times = c(5*(1:9)))
p0c<-autoplot(df_cond_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in Continuous Rotation")
p0c
#could run for TRTs A and B together as well
ABsurv<-survival_data[which(survival_data$TRT_code=="A"|survival_data$TRT_code=="B"),]
#split by condition flag
ABsurv_fit <- survfit(Surv(time, status) ~ 1, data = ABsurv)
p12<-autoplot(ABsurv_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in 12y Rotation", ylim = c(0,1))
ABsurv_cond_fit <- survfit(Surv(time, status) ~ Cond_flag, data = ABsurv)
p12
summary(ABsurv_cond_fit, times = c(5*(1:9)))
p12c<-autoplot(ABsurv_cond_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in 12y Rotation")
p12c
p0+p12
p0c+p12c
#pdf(here("Summary_Graphs_update","Surv_curve_12y_vs_DF.pdf"), height= 6, width = 12)
#p0+p12
#dev.off()
#pdf(here("Summary_Graphs_update","Surv_curve_by_condition_12y_vs_DF.pdf"), height= 6, width = 12)
#p0c+p12c
#dev.off()
#split by rep
df_rep_fit <- survfit(Surv(time, status) ~ REP, data = dfsurv)
summary(df_rep_fit, times = c(5*(1:9)))
p0r<-autoplot(df_rep_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in Continuous Rotation")+scale_fill_viridis_d()+scale_color_viridis_d()
p0r
ABsurv_rep_fit <- survfit(Surv(time, status) ~ REP, data = ABsurv)
summary(ABsurv_rep_fit, times = c(5*(1:9)))
p12r<-autoplot(ABsurv_rep_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in 12y Rotation")+scale_fill_viridis_d()+scale_color_viridis_d()
p12r
#trying a cox proportional hazard model to include covariates
#this probably shouldn't be done on the full dataset since it seems to think that ABDE treatments die after there are no more measurements
cox<- coxph(Surv(time,status) ~ TRT_code + REP + Cond_flag, data = survival_data)
summary(cox)
cox_fit <- survfit(cox)
pc<-autoplot(cox_fit, xlim=c(0,50))
pc
pkm|pc
#may need to specify reference levels for all of the variables (TRT_code C, Cond_flag= NONE, REP=1)
svg(here("Summary_Graphs_update","Surv_curve_12y_vs_DF.svg"), height= 6, width = 10)
p0+p12
dev.off()
svg(here("Summary_Graphs_update","Surv_curve_by_condition_12y_vs_DF.svg"), height= 6, width = 10)
p0c+p12c
dev.off()
#make test data set to confirm the appropriate data structure
#with only live time points
TreeID<-c(101,101,101,102,102,103,103,103,104,104,104)
Age<-c(8,22,34,10,26,12,24,36,8,34,45)
DBH<-c(5,8,15,4,7,9,15,25,6,12,19)
LRR<-c("N","N","N","Y","Y","N","N","N","Y","Y","Y")
df<-data.frame(TreeID,Age,DBH,LRR)
df
d<-ggplot()+geom_path(data=df, group=TreeID, aes(x=Age, y=DBH,colour=LRR))+theme_bw()
d
#with NA DBH for dead tree at a given age, also attempting to add trend line and 95%CI
TreeID2<-c(101,101,101,102,102,102,103,103,103,104,104,104)
Age2<-c(8,22,34,10,26,36,12,24,36,8,34,45)
DBH2<-c(5,8,15,4,7,NA,9,15,25,6,12,19)
LRR2<-c("N","N","N","Y","Y","Y","N","N","N","Y","Y","Y")
df2<-data.frame(TreeID2,Age2,DBH2,LRR2)
df2
d2<-ggplot(df2,aes(x=Age2, y=DBH2,colour=LRR2))+geom_path(group=TreeID2)+theme_bw()+geom_smooth(method = lm)
d2
#either structure seems to work, so I will likely use the DBH=NA to preserve data.
#this would also allow for adding a custom timepoint/age at year of death when this was recorded/estimated along with diameter of dead tree.
#the dataset "lessA1A3" seems to be the best starting point to generate the input for this analysis
#seeing which columns to keep
head(lessA1A3)
# 1,4:7,11:13,21
growth_test<-lessA1A3[,c(1,4:7,10:13,28,30)]
#calculate a live DBH in cm
growth_test$live_DBH_cm<-ifelse(growth_test$Tree_status=="Alive", #test if alive
growth_test$DBH_mm /10, #if yes, then divide mm DBH by 10
NA) #otherwise (Dead or NA), make NA
#need to propagate LRR flag to all time points for the same tree. Could maybe use YEAR_dbl.
#may be a good idea to first generate a vector that contains the Tree_IDs for which LRR==1 in any year
LRR_trees<-growth_test[which(growth_test$LRR==1),1]
LRR_list<-c(unique(LRR_trees$Tree_ID))
SUP_trees<-growth_test[which(growth_test$SUP==1),1]
SUP_list<-c(unique(SUP_trees$Tree_ID))
growth_test$Cond_flag<-ifelse(!is.na(growth_test$Tree_status), #test not NA
ifelse(growth_test$Tree_ID %in% LRR_list, #if so, test LRR
"LRR", #if so, print LRR
ifelse(growth_test$Tree_ID %in% SUP_list,#if not test SUPP
"SUP", #if so, print SUP
"NONE")), #if not, print NONE
NA) #if not not NA, print NA
growth_test2<-growth_test %>% filter(!is.na(growth_test$DF_age))
dbh_plot<-ggplot(growth_test2,aes(DF_age,live_DBH_cm,colour=Cond_flag))+geom_path(group=growth_test2$Tree_ID, alpha=0.1, na.rm = TRUE)+theme_bw()+geom_smooth(method = lm)+facet_row(growth_test2$TRT)+scale_color_viridis_d()
dbh_plot
#the plot produced from the above code works but the trendlines may not be representative because they calculate the slope across three measurements (two slopes). Since the LRR trees are more likely not to have a third measurement, this may bias the overall slope. Could perhaps limit the datasets to two measurements, and thus one slope per tree per interval. 25y treatments only have one interval. DF and 12y have two intervals that don't necessarily overlap. Could just use same windows for comparison as slope boxplots (12 and 25 with Early, 12 and DF with mid, and DF with Late)
#could use just DF trees and just 1st and 2nd measurements. This would  This still wouldn't account for trees that died of LRR, unless we were able to do the age at death corrections from the datasheet notes.
#keep ages 8,12,33,36 i.e. "Mid"
growth_test_mid<-growth_test2 %>% filter(growth_test2$DF_age==8|growth_test2$DF_age==12|growth_test2$DF_age==33|growth_test2$DF_age==36)
dbh_plot_mid<-ggplot(growth_test_mid,aes(DF_age,live_DBH_cm)) +geom_path(group=growth_test_mid$Tree_ID, alpha=0.15, aes(colour=Cond_flag)) +theme_bw() +geom_smooth(method = lm, aes( linetype=Cond_flag,fill=Cond_flag,colour=Cond_flag)) +facet_row(growth_test_mid$TRT) +scale_color_viridis_d() +labs(title="Midle Phase Growth", x="Douglas Fir Age",y="DBH (mm)") +scale_fill_viridis_d()
dbh_plot_mid
##keep ages 8,11,20,24 i.e. "Early"
growth_test_early<-growth_test2 %>% filter(growth_test2$DF_age==8|growth_test2$DF_age==11|growth_test2$DF_age==20|growth_test2$DF_age==24)
dbh_plot_early<-ggplot(growth_test_early,aes(DF_age,live_DBH_cm)) +geom_path(group=growth_test_early$Tree_ID, alpha=0.15, aes(colour=Cond_flag)) +theme_bw() +geom_smooth(method = lm, aes( linetype=Cond_flag,fill=Cond_flag,colour=Cond_flag)) +facet_row(growth_test_early$TRT) +scale_color_viridis_d() +labs(title="Early Phase Growth", x="Douglas Fir Age",y="DBH (mm)") +scale_fill_viridis_d()
dbh_plot_early
##keep ages 36,45 i.e. "Late"
growth_test_late<-growth_test2 %>% filter(growth_test2$DF_age==36|growth_test2$DF_age==45)
dbh_plot_late<-ggplot(growth_test_late,aes(DF_age,live_DBH_cm)) +geom_path(group=growth_test_late$Tree_ID, alpha=0.15, aes(colour=Cond_flag)) +theme_bw() +geom_smooth(method = lm, aes( linetype=Cond_flag,fill=Cond_flag,colour=Cond_flag)) +facet_row(growth_test_late$TRT) +scale_color_viridis_d() +labs(title="Late Phase Growth", x="Douglas Fir Age",y="DBH (mm)") +scale_fill_viridis_d()
dbh_plot_late
