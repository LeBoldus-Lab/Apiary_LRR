wide_for_dam$late_BA_slope<-(wide_for_dam$Live_BA_mpha_T4-wide_for_dam$Live_BA_mpha_T3)/(wide_for_dam$DF_age_T4-wide_for_dam$DF_age_T3)
wide_for_dam$early_prop_dead_slope<-(wide_for_dam$prop_dead_T2-wide_for_dam$prop_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$mid_prop_dead_slope<-(wide_for_dam$prop_dead_T3-wide_for_dam$prop_dead_T1)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_dead_slope<-(wide_for_dam$prop_dead_T4-wide_for_dam$prop_dead_T3)/(wide_for_dam$DF_age_T4-wide_for_dam$DF_age_T3)
wide_for_dam$early_prop_LRR_dead_slope<-(wide_for_dam$prop_LRR_dead_T2-wide_for_dam$prop_LRR_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$mid_prop_LRR_dead_slope<-(wide_for_dam$prop_LRR_dead_T3-wide_for_dam$prop_LRR_dead_T1)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_LRR_dead_slope<-(wide_for_dam$prop_LRR_dead_T4-wide_for_dam$prop_LRR_dead_T3)/(wide_for_dam$DF_age_T4-wide_for_dam$DF_age_T3)
wide_for_dam$early_prop_LRRNO_dead_slope<-(wide_for_dam$prop_LRRNO_dead_T2-wide_for_dam$prop_LRRNO_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$mid_prop_LRRNO_dead_slope<-(wide_for_dam$prop_LRRNO_dead_T3-wide_for_dam$prop_LRRNO_dead_T1)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_LRRNO_dead_slope<-(wide_for_dam$prop_LRRNO_dead_T4-wide_for_dam$prop_LRRNO_dead_T3)/(wide_for_dam$DF_age_T4-wide_for_dam$DF_age_T3)
wide_for_dam$early_prop_SUP_dead_slope<-(wide_for_dam$prop_SUP_dead_T2-wide_for_dam$prop_SUP_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$mid_prop_SUP_dead_slope<-(wide_for_dam$prop_SUP_dead_T3-wide_for_dam$prop_SUP_dead_T1)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_SUP_dead_slope<-(wide_for_dam$prop_SUP_dead_T4-wide_for_dam$prop_SUP_dead_T3)/(wide_for_dam$DF_age_T4-wide_for_dam$DF_age_T3)
wide_for_dam$early_prop_No_damage_dead_slope<-(wide_for_dam$prop_No_damage_dead_T2-wide_for_dam$prop_No_damage_dead_T1)/(wide_for_dam$DF_age_T2-wide_for_dam$DF_age_T1)
wide_for_dam$mid_prop_No_damage_dead_slope<-(wide_for_dam$prop_No_damage_dead_T3-wide_for_dam$prop_No_damage_dead_T1)/(wide_for_dam$DF_age_T3-wide_for_dam$DF_age_T1)
wide_for_dam$late_prop_No_damage_dead_slope<-(wide_for_dam$prop_No_damage_dead_T4-wide_for_dam$prop_No_damage_dead_T3)/(wide_for_dam$DF_age_T4-wide_for_dam$DF_age_T3)
