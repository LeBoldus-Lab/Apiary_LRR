# calculate BA50 (diameter at which 50% of the basal area is in smaller trees and 50% is in larger trees)
#select relevant columns
BA50.df<-long_data[,c("TRT","BLOCK","PLOT","Tree_ID_TBP","species_gen","YEAR", "live_DIA","live_BA")]
#remove rows without live diameter measurements
BA50.df<-subset(BA50.df, !is.na(BA50.df$live_BA))
#subset to 1990 measurements
BA50.df.90<-subset(BA50.df, BA50.df$YEAR==1990)
#calculate cumulative sum of live basal areas by TRTxBlock starting with the smallest tree
test.cumsum_1990<- BA50.df.90 %>% group_by(TRT,BLOCK) %>% arrange(live_DIA, .by_group = TRUE) %>% summarise(live_DIA=live_DIA,live_BA=live_BA, cumsum_live_BA_TB=cumsum(live_BA),n=1:n(), BA50=(max(cumsum_live_BA_TB)/2), BA50flag=ifelse(BA50<=cumsum_live_BA_TB, TRUE, FALSE), BA50Dfirst=min(ifelse(BA50flag==TRUE,live_DIA,NA), na.rm = TRUE), BA50n=min(ifelse(BA50flag==TRUE,n,NA), na.rm = TRUE), median_n=median(n), QMD=sqrt(sum(live_BA)/(n()*0.00007854)))
BA50_plots_1990<- ggplot(test.cumsum_1990,aes(x=n,y=cumsum_live_BA_TB))+
geom_col(aes(fill=test.cumsum_1990$TRT))+
geom_vline(xintercept = test.cumsum_1990$BA50n)+
geom_hline(yintercept = test.cumsum_1990$BA50, linetype=2)+
geom_vline(xintercept = test.cumsum_1990$median_n, linetype=2)+
geom_label(aes(test.cumsum_1990$BA50n, 12,label=paste( "50% BA DBH \n",test.cumsum_1990$BA50Dfirst," cm"), label.size=0.25)) +
facet_grid(cols=vars(test.cumsum_1990$TRT), rows=vars(test.cumsum_1990$BLOCK))+
labs(x="1990 Tree DBH Rank (small to large)", y= "1990 Cumulative BA Sum")+
theme_bw()+
theme(legend.position="none", panel.grid = element_blank(),panel.background = element_blank())
BA50_plots_1990
BA50_summary_1990<-test.cumsum_1990 %>% group_by(TRT,BLOCK) %>% summarise(BA50D=median(BA50Dfirst), median_DIA=median(live_DIA), QMD=median(QMD))
BA50_summary_1990_plot<-ggplot(BA50_summary_1990,aes(median_DIA,BA50D, color=TRT))+
geom_text(label=BA50_summary_1990$BLOCK, fontface="bold")+
geom_function(fun=function(x) x, linetype=2, color="black")+
theme_bw()+
theme( panel.grid = element_blank(),panel.background = element_blank())+
stat_smooth(method = lm,colour="black", aes(fill=TRT))+
labs(x="1990 median tree diameter (cm)", y="1990 BA50 tree diameter (cm)")
BA50_summary_1990_plot
BA50_QMD_1990_plot<-ggplot(BA50_summary_1990,aes(QMD,BA50D, color=TRT))+
geom_text(label=BA50_summary_1990$BLOCK, fontface="bold")+
geom_function(fun=function(x) x, linetype=2, color="black")+
theme_bw()+
theme( panel.grid = element_blank(),panel.background = element_blank())+
stat_smooth(method = lm,colour="black", aes(fill=TRT))+
labs(x="1990 quadratic mean tree diameter (cm)", y="1990 BA50 tree diameter (cm)")
BA50_QMD_1990_plot
