# calculate QMD by Year TRT Block
#select relevant columns
QMD.df<-long_data[,c("TRT","BLOCK","PLOT","Tree_ID_TBP","species_gen","YEAR", "live_DIA","live_BA")]
#remove rows without live diameter measurements
QMD.df<-subset(QMD.df, !is.na(QMD.df$live_BA))
#calculate cumulative sum of live basal areas by TRTxBlock starting with the smallest tree
QMD_stand<- QMD.df %>% group_by(YEAR,TRT,BLOCK) %>% summarise(QMD=sqrt(sum(live_BA)/(n()*0.00007854)))
QMD_TRT_YEAR<-QMD_stand%>%group_by(TRT, YEAR) %>% summarise(QMD_mean=mean(QMD),SE=(sd(QMD)/sqrt(n())), lower=QMD_mean-SE, upper=QMD_mean+SE,CI=qt(0.975,df=(n()-1))*SE,lower.CI=QMD_mean-CI,upper.CI=QMD_mean+CI)
QMD_TRT_YEAR
QMD_TRT_YEAR_plot<-ggplot(QMD_TRT_YEAR,aes(YEAR,QMD_mean))+
geom_point(aes(color=TRT), position=position_dodge(width=0.5))+
geom_errorbar(aes(ymin=lower.CI,ymax=upper.CI, color=TRT),width=0.2, position=position_dodge(width=0.5))+
labs(y='Stand Mean (+/- 95% CI) Quadratic Mean Diameter (cm)')+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(),legend.position = "none")
QMD_TRT_YEAR_plot
