survival_keep<-c("Tree_ID","REP","TRT_code","DEAD_YEAR","STS_2011","NSTS")
survival_data<-as.data.frame(full_data[,(colnames(full_data) %in% survival_keep)])
#remove reps 1 and 3 from RA12
survival_data<-survival_data[-(which(survival_data$TRT_code=="A"& survival_data$REP=="1")),]
survival_data<-survival_data[-(which(survival_data$TRT_code=="A"& survival_data$REP=="3")),]
#assign status=0 for trees that were alive in 2020 and status=1 to trees that died during the study
survival_data$status<-ifelse(survival_data$NSTS=="1",0,1)
#use combination of TRT_code, NSTS, and DEAD_year to calculate "survival time" for each tree.
#to simplify calculating survival time, start with assigning a start year for each treatment
survival_data$begin<-ifelse(survival_data$TRT_code=="A"|survival_data$TRT_code=="B",
1987,
ifelse(survival_data$TRT_code=="C",
1975, 2000))
survival_data$time<-ifelse(survival_data$status==0, #if tree is alive in 2020
(2020-survival_data$begin), #subtract begin from 2020
ifelse(survival_data$STS_2011=="1", # if tree is alive in 2011
(2020-survival_data$begin), #then subtract begin from 2020
(survival_data$DEAD_YEAR- survival_data$begin) #if not, then subtract begin from DEAD_YEAR
)
)
#use "LRR_list" and "SUP_list" to add grouping flags to trees. From lines 2808 and 2810
survival_data$Cond_flag<-    ifelse(survival_data$Tree_ID %in% LRR_list, # test LRR
"LRR", #if so, print LRR
ifelse(survival_data$Tree_ID %in% SUP_list,#if not, test SUPP
"SUP", #if so, print SUP
"NONE")) #if not, print NONE
#now try making survival object and Kaplan-Meier estimates
