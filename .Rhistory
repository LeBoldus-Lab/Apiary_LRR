#looking whether there are a lot of Alive suppressed trees in A1 and A3 reps. Which looks like NO.
AxSxP<-long_data_keep %>% group_by(TRT, REP, DF_age, Tree_status, DAMAGE, .drop=FALSE) %>% summarise(count=n())
#then why are the trees so small in those reps?
#subset by treatments and treatments with similar ages
RACW10<-subset(long_data_keep, (TRT=="RA10Y" |TRT=="CW10Y"))
RACW20<-subset(long_data_keep, (TRT=="RA20Y" |TRT=="CW20Y"))
RA10<-subset(long_data_keep, TRT=="RA10Y")
CW10<-subset(long_data_keep, TRT=="CW10Y")
DF0<-subset(long_data_keep, TRT=="DF0Y")
CW20<-subset(long_data_keep, TRT=="CW20Y")
RA20<-subset(long_data_keep, TRT=="RA20Y")
#for ABC dataset
RACW10_ABC<-subset(ABC_long_keep, (TRT=="RA10Y" |TRT=="CW10Y"))
RA10_ABC<-subset(ABC_long_keep, TRT=="RA10Y")
CW10_ABC<-subset(ABC_long_keep, TRT=="CW10Y")
DF0_ABC<-subset(ABC_long_keep, TRT=="DF0Y")
long_data_keep$Tree_ID_TRS<-paste(long_data_keep$TRT_code,long_data_keep$REP,long_data_keep$SUBPLOT,long_data_keep$TREE, sep = "_")
#creating unique subplotplot ID factor varaible of format TRT_REP_SUBPLOT
long_data_keep$Subplot_ID_TRS<-as.factor(paste(long_data_keep$TRT_code,long_data_keep$REP,long_data_keep$SUBPLOT, sep = "_"))
#creating subplot level DF excluding trees with no status recorded (like 1987 measurements for ABDE and 1995 for CDE)
#sources for:
#removing STATUS=NA https://stackoverflow.com/questions/29501188/dplyr-removing-nas-from-group-by-variable
#excluding Live_BA_sq_m = 0 https://stackoverflow.com/questions/54805570/dplyr-summarise-keep-na-if-all-summarised-values-are-na/54805923
#subplot_df<-long_data_keep %>% filter(!is.na(STATUS)) %>% group_by(Subplot_ID_TRS, YEAR_fac,TRT, STATUS, .drop = TRUE) %>% summarise(count = n(), Live_BA_sq_m = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m, na.rm=TRUE))
#using DF age instead of year and adding PW and PW+root rot counts
subplot_df_age<-long_data_keep %>% filter(!is.na(STATUS)) %>% group_by(Subplot_ID_TRS, DF_age,TRT, STATUS, .drop = TRUE) %>% summarise(count = n(), Live_BA_sq_m = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m, na.rm=TRUE),PW=sum(!is.na(PW)), PW_R=sum(!is.na(PW_R)))
# correcting subplot-level Live-BA to include area sampled (ha)
# subplots have 27' radius = 1/20 or 0.053 acre = 0.021448339 hectare
subplot_df_age$Live_BA_mpha<-subplot_df_age$Live_BA_sq_m/0.021448339
# 1 sq m = 10.7639 sq ft
subplot_df_age$Live_BA_sq_ft<-subplot_df_age$Live_BA_sq_m*10.7639
subplot_df_age$Live_BA_fpa<-subplot_df_age$Live_BA_sq_ft/.053
#adding the separate TMT, BLOCK, and PLOT columns
subplot_df_age<-subplot_df_age %>% separate(Subplot_ID_TRS, c("TRT","REP","SUBPLOT"),"_",remove = FALSE)
#subplot_df_age$TRT<-as.factor(subplot_df_age$TRT)
#subplot_df_age$REP<-as.factor(subplot_df_age$REP)
#subplot_df_age$SUBPLOT<-as.factor(subplot_df_age$SUBPLOT)
#creating unique stand ID factor varaible of format TRT_BLOCK
subplot_df_age$Stand_ID_TR<-as.factor(paste(subplot_df_age$TRT,subplot_df_age$REP, sep = "_"))
# updating to calculate stand-level Live-BA mph and fpa by taking the mean of subplots rather than summing so I can account for missing data/subplots
#calculating whether or not subplots had Pw (807) or PW or root rot (806 or 807) at the first measurement (10 or 12 y)
PW_in_subplot_1012<-subplot_df_age %>% filter(DF_age==10|DF_age==12) %>% group_by(Subplot_ID_TRS, .drop = TRUE) %>% summarise(PW=sum(PW), PW_R=sum(PW_R))
#none of the 10 or 12y measurements had any PW, likely because all of those notes were input as from the second measurement off of the datasheets. I'm unable to tell which comments on the datasheet corresponded to the first measurement or the second measurement.
#instead I will just use REP and as a proxy for FVS parameter related to initial incidence, since that is what was used to determine the blocking anyway. Rep 1=0.2, Rep 2=0.4, Rep 3=0.6 Rep 4=0.8 Rep 0=1.0
stand_df_age<- subplot_df_age %>% filter(!is.na(STATUS)) %>% group_by(Stand_ID_TR, DF_age, TRT, STATUS, .drop = TRUE) %>% summarise(count = sum(count, na.rm=TRUE), sum_Live_BA_sq_m = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else mean(Live_BA_mpha, na.rm=TRUE), sum_Live_BA_sq_ft = if(all(is.na(Live_BA_sq_ft))) NA_real_ else sum(Live_BA_sq_ft, na.rm=TRUE), Live_BA_fpa = if(all(is.na(Live_BA_fpa))) NA_real_ else mean(Live_BA_fpa, na.rm=TRUE),PW=sum(PW), PW_R=sum(PW_R))
#adding the separate REP column
stand_df_age<-stand_df_age %>% separate(Stand_ID_TR, c(NA,"REP"),"_",remove = FALSE)
#stand_df_age$REP<-as.factor(stand_df_age$REP)
subplot_ABC<- subplot_df_age[subplot_df_age$TRT=="A"|subplot_df_age$TRT=="B"|subplot_df_age$TRT=="C",]
stand_ABC<- stand_df_age[stand_df_age$TRT=="A"|stand_df_age$TRT=="B"|stand_df_age$TRT=="C",]
subplot_ABC$SEV<-ifelse(subplot_ABC$REP=="0","5",subplot_ABC$REP)
stand_ABC$SEV<-ifelse(stand_ABC$REP=="0","5",stand_ABC$REP)
subplot_ABC$Treatment<-ifelse(subplot_ABC$TRT=="A",
"10RA",
ifelse(subplot_ABC$TRT=="B",
"10CW", "DF"))
stand_ABC$Treatment<-ifelse(stand_ABC$TRT=="A",
"10RA",
ifelse(stand_ABC$TRT=="B",
"10CW", "DF"))
FVS_Prep<-filter(ABC_long_keep, FVS_age==0 & !is.na(Tree_status))
FVS_Prep$Tnum<-as.numeric(ifelse(FVS_Prep$TRT_code=="A",10,ifelse(FVS_Prep$TRT_code=="B",20,30)))
FVS_Prep$SEV<-ifelse(FVS_Prep$REP==0,5,FVS_Prep$REP)
FVS_Prep$root_prop<-FVS_Prep$SEV * 0.2
FVS_Prep$STAND_CN<-paste0(FVS_Prep$Tnum,FVS_Prep$SEV,sep="")
FVS_Prep$STAND_ID<-paste0(FVS_Prep$Tnum,FVS_Prep$SEV,FVS_Prep$SEV,sep="")
FVS_Prep$PLOT_ID<-FVS_Prep$SUBPLOT
FVS_Prep$PLOT_CN<-paste0(FVS_Prep$STAND_ID,FVS_Prep$PLOT_ID,sep="")
FVS_Prep$STANDPLOT_CN<-paste0(FVS_Prep$STAND_CN,"_000",FVS_Prep$PLOT_ID,sep="")
FVS_Prep$STANDPLOT_ID<-paste0(FVS_Prep$STAND_ID,"_000",FVS_Prep$PLOT_ID,sep="")
FVS_Prep$TREE_ID<-FVS_Prep$TREE
FVS_Prep$HISTORY<-ifelse(FVS_Prep$STATUS=="3","6",FVS_Prep$STATUS)
FVS_Prep$DIAMETER<-(FVS_Prep$DBH_mm * 0.03937)
