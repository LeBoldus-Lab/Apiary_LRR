TukeyHSD()
?Tukey()
?TukeyHSD()
TukeyHSD(BAFmodel,TMT, conf.level = 0.95)
?difflsmeans()
difflsmeans(BAFmodel,TMT)
BAFmodel
difflsmeans(BAFmodel,test.effs = "TMT")
difflsmeans(BAFmodel,test.effs = "TMT", ddf="Kenward-Roger")
difflsmeans(BAFmodel,test.effs = "TMT", level = 0.95)
?emmeans()
?pairs()
pairs(BAFmodel, adjust="Tukey")
BAFmodel<-emmeans(early_BA_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
BAFmodel.em<-emmeans(BAFmodel, "TMT")
pairs(BAFmodel.em, adjust="tukey")
eba_posthoc<-pairs(BAFmodel.em, adjust="tukey")
eba_posthoc
View(eba_posthoc)
View(eba_posthoc)
