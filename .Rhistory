EaS.df<-as.data.frame(EaS.em)
EaS.df$TMT<-as.factor(c("RA 12Y", "CW 12Y","RA 25Y","CW 25Y"))
EaS.df$TMT<- ordered(EaS.df$TMT, levels = c("RA 12Y","CW 12Y","RA 25Y","CW 25Y"))
#adding posthoc results
EaS.df$tukey<-c("ab","b","ab","a")
EaS.df$lower<-EaS.df$emmean-EaS.df$SE
EaS.df$upper<-EaS.df$emmean+EaS.df$SE
EaS.df$backtran<-(sin(EaS.df$emmean))^2
EaS.df$CL<-EaS.df$upper.CL-EaS.df$emmean
EaS.df$backtran_CL<-(sin(EaS.df$CL))^2
EaS.df$backtran_upper.CL<-EaS.df$backtran+EaS.df$backtran_CL
EaS.df$backtran_lower.CL<-EaS.df$backtran-EaS.df$backtran_CL
View(EaS.df)
ES_bar<-ggplot(EaS.df,aes(TMT,backtran))+
geom_col(aes(fill=TMT))+
geom_errorbar(aes(ymin=backtran_lower.CL,ymax=backtran_upper.CL),width=0.2)+
labs(title="Early" ,x="",y='Stand Mean (+/- 95% CI) Annual Suppression Mortality')+
scale_fill_manual(values=trt_colors[c(1,2,4,5)])+
geom_text(aes(label=tukey,y= EaS.df$backtran_upper.CL+0.001),show.legend = FALSE)+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(),legend.position = "none")
ES_bar
MMSaF<-lm(mid_asn_prop_SUP_dead_slope ~ TMT , data = ANOVA_mid)
plot(MMSaF)
summary(MMSaF)
anova(MMSaF)
MMSaF.rg1<-ref_grid(MMSaF)
summary(MMSaF.rg1)
mslsm<-summary(MMSaF.rg1)
#backtransform mortality estimates for reporting
mslsm$backtran<-(sin(mslsm$prediction))^2
mslsm
#doing post-hoc tests
MaSF.em<-emmeans(MMSaF, "TMT")
MaSF_posthoc<-pairs(MaSF.em, adjust="tukey")
MaSF_posthoc
plot(MaSF.em,comparisons = TRUE)
late_SUP_mort_means<-ANOVA_late %>% group_by(TMT)%>% summarise(Estimate=mean(late_prop_SUP_dead_slope),SE=(sd(late_prop_SUP_dead_slope)/sqrt(n())), lower=Estimate-SE, upper=Estimate+SE,CI=qt(0.975,df=(n()-1))*SE,lower.CI=Estimate-CI,upper.CI=Estimate+CI)
