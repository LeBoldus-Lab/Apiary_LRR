#generate data subset for ANOVA
AOV_in<-stand_df_age
AOV_Alive<-subset(AOV_in, AOV_in$STATUS==1)
AOV_Alive_count<- AOV_Alive %>% group_by(Stand_ID_TR, DF_age)%>%summarise(Alive=sum(count, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else sum(Live_BA_mpha, na.rm=TRUE), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
AOV_Dead<-subset(AOV_in, AOV_in$STATUS==3)
AOV_Dead_count<- AOV_Dead %>% group_by(Stand_ID_TR, DF_age)%>%summarise(Dead=sum(count, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else sum(Live_BA_mpha, na.rm=TRUE), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#attempt to merge datasets but there are not "Dead" entries for all of the stand/year combinations
#need to add rows for stand years with zero Dead trees https://www.statology.org/r-append-to-data-frame/
Dead_add<-data.frame("Stand_ID_TR"=c("B_2", "B_3", "B_4"),
"DF_age"=c(8, 8, 8),
"Dead"=c(0, 0, 0),
"Live_BA_mpha"=c(NA,NA, NA))
Dead_add$Stand_ID_TR<-Dead_add$Stand_ID_TR
Dead_add$DF_age<-as.double(Dead_add$DF_age)
Dead_add$Dead<-as.integer(Dead_add$Dead)
Dead_add$Live_BA_mpha<-as.double(Dead_add$Live_BA_mpha)
AOV_Dead_count_add<-rbind(AOV_Dead_count, Dead_add)
#need to have rows in same order to cbind
AOV_Dead_count_add_sort<-AOV_Dead_count_add[c(1:15,57,16,17,58,18,19,59,20:56),]
AOV_prop_Dead<-cbind(AOV_Alive_count, AOV_Dead_count_add_sort[,"Dead"])
#AOV_prop_Dead<-cbind(AOV_Alive_count, AOV_Dead_count_add_sort[,"SUPP"])
#AOV_prop_Dead<-cbind(AOV_Alive_count, AOV_Dead_count_add_sort[,"LRR"])
#AOV_prop_Dead<-cbind(AOV_Alive_count, AOV_Dead_count_add_sort[,"N_O"])
#AOV_prop_Dead<-cbind(AOV_Alive_count, AOV_Dead_count_add_sort[,"LRRNO"])
AOV_prop_Dead$total<-(AOV_prop_Dead$Alive+AOV_prop_Dead$Dead)
AOV_prop_Dead$prop_Dead<-(AOV_prop_Dead$Dead/AOV_prop_Dead$total)
#AOV_prop_Dead$prop_D_miss<-((pmax(AOV_prop_Dead$total,170)-AOV_prop_Dead$Alive)/pmax(AOV_prop_Dead$total,170))
AOV_prop_Dead$prop_Alive<-1-AOV_prop_Dead$prop_Dead
#AOV_prop_Dead$prop_A_miss<-1-AOV_prop_Dead$prop_D_miss
#add unique block and tmt designations and make them factors
AOV_prop_Dead<-AOV_prop_Dead %>% separate(Stand_ID_TR, c("TRT","REP"),"_",remove = FALSE)
#AOV_prop_Dead$TRT<-as.factor(AOV_prop_Dead$TRT)
#AOV_prop_Dead$REP<-as.factor(AOV_prop_Dead$REP)
#arcsine transforrmation of proportion Dead
AOV_prop_Dead$asn_mort<-asin(sqrt(AOV_prop_Dead$prop_Dead))
#adding descriptive treatment name
AOV_prop_Dead$Treatment<-ifelse(AOV_prop_Dead$TRT=="A",
"Red Alder 12 years",
ifelse(AOV_prop_Dead$TRT=="B",
"Cottonwood 12 years",
ifelse(AOV_prop_Dead$TRT=="C",
"Immediate Douglas fir",
ifelse(AOV_prop_Dead$TRT=="D",
"Red Alder 25 years", "Cottonwood 25 years"
))))
#creating stand means and SE for BA and asin prop mort, and prop mort, prop Inferred mort
AOV_BA_stand_mean<- stand_df_age %>% group_by(TRT, DF_age)%>%summarise( Stand_N_BA = sum(!is.na(Live_BA_mpha)),mean_BA=mean(Live_BA_mpha, na.rm=TRUE), sd_BA = sd(Live_BA_mpha, na.rm=TRUE),se_BA = sd_BA / sqrt(Stand_N_BA), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#AOV_BA_stand_mean$age<-as.numeric(AOV_BA_stand_mean$DF_age)
#adding descriptive treatment name
AOV_BA_stand_mean$Treatment<-ifelse(AOV_BA_stand_mean$TRT=="A",
"Red Alder 12 years",
ifelse(AOV_BA_stand_mean$TRT=="B",
"Cottonwood 12 years",
ifelse(AOV_BA_stand_mean$TRT=="C",
"Immediate Douglas fir",
ifelse(AOV_BA_stand_mean$TRT=="D",
"Red Alder 25 years", "Cottonwood 25 years"
))))
AOV_BA_stand_mean$lower_BA<-AOV_BA_stand_mean$mean_BA-AOV_BA_stand_mean$se_BA
AOV_BA_stand_mean$upper_BA<-AOV_BA_stand_mean$mean_BA+AOV_BA_stand_mean$se_BA
AOV_BA_minmax<- stand_df_age %>% group_by(TRT, DF_age)%>%summarise( BA_minmax_N = sum(!is.na(Live_BA_mpha)),med_BA=median(Live_BA_mpha, na.rm=TRUE), min_BA = min(Live_BA_mpha, na.rm=TRUE),max_BA = max(Live_BA_mpha, na.rm=TRUE), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#AOV_BA_minmax$age<-as.numeric(AOV_BA_minmax$DF_age)
#adding descriptive treatment name
AOV_BA_minmax$Treatment<-ifelse(AOV_BA_minmax$TRT=="A",
"Red Alder 12 years",
ifelse(AOV_BA_minmax$TRT=="B",
"Cottonwood 12 years",
ifelse(AOV_BA_minmax$TRT=="C",
"Immediate Douglas fir",
ifelse(AOV_BA_minmax$TRT=="D",
"Red Alder 25 years", "Cottonwood 25 years"
))))
AOV_asnmort_stand_mean<- AOV_prop_Dead %>% group_by(TRT, DF_age)%>%summarise( asnmort_N = sum(!is.na(asn_mort)),asn_mort_mean=mean(asn_mort, na.rm=TRUE), asn_mort_sd = sd(asn_mort, na.rm=TRUE),asn_mort_se = sd(asn_mort, na.rm=TRUE) / sqrt(asnmort_N), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#AOV_asnmort_stand_mean$age<-as.numeric(AOV_asnmort_stand_mean$DF_age)
#adding descriptive treatment name
AOV_asnmort_stand_mean$asn_mort_lower<-AOV_asnmort_stand_mean$asn_mort_mean-AOV_asnmort_stand_mean$asn_mort_se
AOV_asnmort_stand_mean$asn_mort_upper<-AOV_asnmort_stand_mean$asn_mort_mean+AOV_asnmort_stand_mean$asn_mort_se
AOV_mort_stand_mean<- AOV_prop_Dead %>% group_by(TRT, DF_age)%>%summarise( mort_N = sum(!is.na(prop_Dead)),mort_mean=mean(prop_Dead, na.rm=TRUE), mort_sd = sd(prop_Dead, na.rm=TRUE),mort_se = sd(prop_Dead, na.rm=TRUE)/ sqrt(mort_N), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#AOV_mort_stand_mean$age<-as.numeric(AOV_mort_stand_mean$DF_age)
#adding descriptive treatment name
AOV_mort_stand_mean$Treatment<-ifelse(AOV_mort_stand_mean$TRT=="A",
"Red Alder 12 years",
ifelse(AOV_mort_stand_mean$TRT=="B",
"Cottonwood 12 years",
ifelse(AOV_mort_stand_mean$TRT=="C",
"Immediate Douglas fir",
ifelse(AOV_mort_stand_mean$TRT=="D",
"Red Alder 25 years", "Cottonwood 25 years"
))))
AOV_mort_stand_mean$mort_lower<-AOV_mort_stand_mean$mort_mean-AOV_mort_stand_mean$mort_se
AOV_mort_stand_mean$mort_upper<-AOV_mort_stand_mean$mort_mean+AOV_mort_stand_mean$mort_se
AOV_mort_minmax<- AOV_prop_Dead %>% group_by(TRT, DF_age)%>%summarise( mort_minmax_N = sum(!is.na(prop_Dead)),med_mort=median(prop_Dead, na.rm=TRUE), min_mort= min(prop_Dead, na.rm=TRUE),max_mort = max(prop_Dead, na.rm=TRUE), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#AOV_mort_minmax$age<-as.numeric(AOV_mort_minmax$DF_age)
#adding descriptive treatment name
AOV_mort_minmax$Treatment<-ifelse(AOV_mort_minmax$TRT=="A",
"Red Alder 12 years",
ifelse(AOV_mort_minmax$TRT=="B",
"Cottonwood 12 years",
ifelse(AOV_mort_minmax$TRT=="C",
"Immediate Douglas fir",
ifelse(AOV_mort_minmax$TRT=="D",
"Red Alder 25 years", "Cottonwood 25 years"
))))
#combining summary statistics into single dataframe
stand_summary_stats<-AOV_prop_Dead
stand_summary_stats$Block<-ifelse(stand_summary_stats$REP==0,5,stand_summary_stats$REP)
#saveRDS(stand_summary_stats, here("stand_summary_stats.Rds"))
treatment_summary_stats<-merge(AOV_BA_stand_mean,AOV_BA_minmax, by=c("TRT","DF_age"))
treatment_summary_stats[ ,c('YEAR_dbl.y', 'Treatment.y')] <- list(NULL)
treatment_summary_stats<-merge(treatment_summary_stats,AOV_mort_stand_mean, by=c("TRT","DF_age"))
treatment_summary_stats[ ,c('YEAR_dbl.x', 'Treatment.x')] <- list(NULL)
treatment_summary_stats<-merge(treatment_summary_stats,AOV_mort_minmax, by=c("TRT","DF_age"))
treatment_summary_stats[ ,c('YEAR_dbl.y', 'Treatment.y')] <- list(NULL)
treatment_summary_stats<-merge(treatment_summary_stats,AOV_asnmort_stand_mean, by=c("TRT","DF_age"))
treatment_summary_stats$Treatment<-treatment_summary_stats$Treatment.x
treatment_summary_stats[ ,c('YEAR_dbl.x', 'Treatment.x')] <- list(NULL)
#saveRDS(treatment_summary_stats, here("treatment_summary_stats.Rds"))
treatment_summary_stats$Treatment<-factor(treatment_summary_stats$Treatment,levels = c("Red Alder 12 years","Cottonwood 12 years","Immediate Douglas fir","Red Alder 25 years","Cottonwood 25 years"))
stand_summary_stats$Treatment<-factor(stand_summary_stats$Treatment,levels = c("Red Alder 12 years","Cottonwood 12 years","Immediate Douglas fir","Red Alder 25 years","Cottonwood 25 years"))
stand_summary_stats$Block<-factor(stand_summary_stats$Block,levels = c(1,2,3,4,5), ordered = TRUE)
