mlsm$backtran_se<-(sin(mlsm$SE))^2
mlsm
EaSmodel<-lmer(early_asn_prop_SUP_dead_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
plot(EaSmodel, type = c("p", "smooth"))
plot(EaSmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(EaSmodel, id = 0.05)
summary(EaSmodel)
anova(EaSmodel)
rand(EaSmodel)
ranef(EaSmodel)
VarCorr(EaSmodel)
ls_means(EaSmodel)
eslsm<-ls_means(EaSmodel)
#backtransform mortality estimates for reporting
eslsm$backtran<-(sin(eslsm$Estimate))^2
eslsm$backtran_se<-(sin(eslsm$`Std. Error`))^2
eslsm
