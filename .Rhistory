#http://animsci.agrenv.mcgill.ca/StatisticalMethodsII/R/RCBD/index.html
#https://cran.r-project.org/web/packages/lme4/vignettes/lmer.pdf
#https://benwhalley.github.io/just-enough-r/contrasts-lmer.html
#wide_for_dam<-readRDS(file= here("wide_stand_summaries_including_damage_codes.Rds"))
#creating unique data subsets for the treatments included for each measurement period (early, mid, late)
#early excludes DF
ANOVA_early<-wide_for_dam[-which(wide_for_dam$TMT=="DF"),]
#mid excludes CW25 and RA25
ANOVA_mid<-wide_for_dam[-which(wide_for_dam$TMT=="RA 25"|wide_for_dam$TMT=="CW 25"),]
#late is just DF
ANOVA_late<-wide_for_dam[which(wide_for_dam$TMT=="DF"),]
#early BA slope
##wide_for_dam$TMT<-relevel(wide_for_dam$TMT, ref = "DF")
#wide_for_dam$Block<-factor(wide_for_dam$Block)
##generating a balanced data set which removes RA12 treatment or removes reps 1 and 3 in other treatments
#no_RA12<-wide_for_dam[-which(wide_for_dam$TMT=="RA 12"),]
#no_RA12$TMT<-factor(no_RA12$TMT, levels= c("DF","CW 12","RA 25","CW 25"))
#no_RA12$TMT<-relevel(no_RA12$TMT, ref = "DF")
#
#no_Block13<-wide_for_dam[-which(wide_for_dam$Block==1|wide_for_dam$Block==3),]
#no_Block13$TMT<-factor(no_Block13$TMT, levels= c("DF","RA 12","CW 12","RA 25","CW 25"))
#no_Block13$TMT<-relevel(no_Block13$TMT, ref = "DF")
#
##running on balanced data sets
#BAmodel<-lmer(early_BA_slope ~ TMT + (1|Block), data = no_RA12, REML=FALSE, verbose = 2)
#plot(BAmodel, type = c("p", "smooth"))
#plot(BAmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
#lattice::qqmath(BAmodel, id = 0.05)
#ranef(BAmodel)
#rand(BAmodel)
#summary(BAmodel)
#
#BA13model<-lmer(early_BA_slope ~ TMT + (1|Block), data = no_Block13, REML=FALSE, verbose = 2)
#plot(BA13model, type = c("p", "smooth"))
#plot(BA13model, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
#lattice::qqmath(BA13model, id = 0.05)
#ranef(BA13model)
#rand(BA13model)
#summary(BA13model)
#don't worry about balancing the datasets (above)
#running on full dataset
BAFmodel<-lmer(early_BA_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
plot(BAFmodel, type = c("p", "smooth"))
plot(BAFmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(BAFmodel, id = 0.05)
summary(BAFmodel)
anova(BAFmodel)
rand(BAFmodel)
ranef(BAFmodel)
VarCorr(BAFmodel)
early_BA_means<-ls_means(BAFmodel)
early_BA_means
#comparing with just a simple fixed effect model
BATmodel<-lm(early_BA_slope ~ TMT, data = ANOVA_early)
summary(BATmodel)
#comparing the two models
anova(BAFmodel, BATmodel)
#using the apropriate trimmed dataset (ANOVA_early) I don't get the convergence error for the random effects model and it has a lower AIC and BIC and makes more sense according to the design of the experiment, so I'll use that.
#mid BA slope
mid_BA_model<-lmer(mid_BA_slope ~ TMT + (1|Block), data = ANOVA_mid, REML=FALSE, verbose = 2)
plot(mid_BA_model, type = c("p", "smooth"))
plot(mid_BA_model, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(mid_BA_model, id = 0.05)
summary(mid_BA_model)
anova(mid_BA_model)
rand(mid_BA_model)
ranef(mid_BA_model)
VarCorr(mid_BA_model)
mid_BA_means<-ls_means(mid_BA_model)
mid_BA_means
#cannot test effect of block on late measurement period because only one observation for each block (DF)
#will just report measured means +/- SE for DF treatment
#early total mortality
EMTFmodel<-lmer(early_prop_dead_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
plot(EMTFmodel, type = c("p", "smooth"))
plot(EMTFmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(EMTFmodel, id = 0.05)
summary(EMTFmodel)
anova(EMTFmodel)
rand(EMTFmodel)
ranef(EMTFmodel)
VarCorr(EMTFmodel)
early_mort<-ls_means(EMTFmodel)
early_mort
#arcsin early total mortality
EMaTFmodel<-lmer(early_asn_prop_dead_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
plot(EMaTFmodel, type = c("p", "smooth"))
plot(EMaTFmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(EMaTFmodel, id = 0.05)
summary(EMaTFmodel)
anova(EMaTFmodel)
rand(EMaTFmodel)
ranef(EMaTFmodel)
VarCorr(EMaTFmodel)
ls_means(EMaTFmodel)
#comparing asn transformed and raw shows transformed is better fit (and slightly better diagnostic plots)
anova(EMTFmodel, EMaTFmodel)
#Trimming CW25 Block 1
trimE1<-ANOVA_early[-c(15),]
EMatrimmodel<-lmer(early_asn_prop_dead_slope ~ TMT + (1|Block), data = trimE1, REML=FALSE, verbose = 2)
plot(EMatrimmodel, type = c("p", "smooth"))
plot(EMatrimmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(EMatrimmodel, id = 0.05)
summary(EMatrimmodel)
anova(EMatrimmodel)
rand(EMatrimmodel)
ranef(EMatrimmodel)
VarCorr(EMatrimmodel)
ls_means(EMatrimmodel)
elsm<-ls_means(EMatrimmodel)
#backtransform mortality estimates for reporting
elsm$backtran<-(sin(elsm$Estimate))^2
elsm$backtran_se<-(sin(elsm$`Std. Error`))^2
elsm
#try simplified model without block, since the model with block won't converge and estimate is 0
EMaF<-lm(early_asn_prop_dead_slope ~ TMT , data = trimE1)
plot(EMaF)
summary(EMaF)
anova(EMaF)
EMaF.rg1<-ref_grid(EMaF)
summary(EMaF.rg1)
elsm<-summary(EMaF.rg1)
#backtransform mortality estimates for reporting
elsm$backtran<-(sin(elsm$prediction))^2
elsm$backtran_se<-(sin(elsm$SE))^2
elsm
