#early mort
EMaF.df<-as.data.frame(EMaF.em)
EMaF.df$TMT<-as.factor(c("RA 12Y", "CW 12Y","RA 25Y","CW 25Y"))
EMaF.df$TMT<- ordered(EMaF.df$TMT, levels = c("RA 12Y","CW 12Y","RA 25Y","CW 25Y"))
#adding posthoc results
EMaF.df$tukey<-c("a","ab","b","a")
EMaF.df$lower<-EMaF.df$emmean-EMaF.df$SE
EMaF.df$upper<-EMaF.df$emmean+EMaF.df$SE
EMaF.df$backtran<-(sin(EMaF.df$emmean))^2
EMaF.df$CL<-EMaF.df$upper.CL-EMaF.df$emmean
EMaF.df$backtran_CL<-(sin(EMaF.df$CL))^2
EMaF.df$backtran_upper.CL<-EMaF.df$backtran+EMaF.df$backtran_CL
EMaF.df$backtran_lower.CL<-EMaF.df$backtran-EMaF.df$backtran_CL
Emort_bar<-ggplot(EMaF.df,aes(TMT,backtran))+
geom_col(aes(fill=TMT))+
