#creating unique stand ID factor varaible of format TRT_BLOCK
subplot_df_age$Stand_ID_TR<-as.factor(paste(subplot_df_age$TRT,subplot_df_age$REP, sep = "_"))
subplot_df_year$Stand_ID_TR<-as.factor(paste(subplot_df_year$TRT,subplot_df_year$REP, sep = "_"))
# updating to calculate stand-level Live-BA mph and fpa by taking the mean of subplots rather than summing so I can account for missing data/subplots
#calculating whether or not subplots had Pw (807) or PW or root rot (806 or 807) at the first measurement (10 or 12 y)
PW_in_subplot_1012<-subplot_df_age %>% filter(DF_age==10|DF_age==12) %>% group_by(Subplot_ID_TRS, .drop = TRUE) %>% summarise(PW=sum(PW), PW_R=sum(PW_R))
#none of the 10 or 12y measurements had any PW, likely because all of those notes were input as from the second measurement off of the datasheets. I'm unable to tell which comments on the datasheet corresponded to the first measurement or the second measurement.
#instead I will just use REP and as a proxy for FVS parameter related to initial incidence, since that is what was used to determine the blocking anyway. Rep 1=0.2, Rep 2=0.4, Rep 3=0.6 Rep 4=0.8 Rep 0=1.0
stand_df_age<- subplot_df_age %>% filter(!is.na(STATUS)) %>% group_by(Stand_ID_TR, DF_age, TRT, STATUS, .drop = TRUE) %>% summarise(count = sum(count, na.rm=TRUE), sum_Live_BA_sq_m = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else mean(Live_BA_mpha, na.rm=TRUE), sum_Live_BA_sq_ft = if(all(is.na(Live_BA_sq_ft))) NA_real_ else sum(Live_BA_sq_ft, na.rm=TRUE), PW=sum(PW), PW_R=sum(PW_R))
stand_df_age<- subplot_df_age %>% filter(!is.na(STATUS)) %>% group_by(Stand_ID_TR, DF_age, TRT, STATUS, .drop = TRUE) %>% summarise(count = sum(count, na.rm=TRUE), sum_Live_BA_sq_m = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else mean(Live_BA_mpha, na.rm=TRUE),  PW=sum(PW), PW_R=sum(PW_R))
stand_df_age<- subplot_df_age %>% filter(!is.na(STATUS)) %>% group_by(Stand_ID_TR, DF_age, TRT, STATUS, .drop = TRUE) %>% summarise(count = sum(count, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else mean(Live_BA_mpha, na.rm=TRUE),  PW=sum(PW), PW_R=sum(PW_R))
