3)) #if not 24, then timpoint 3m close test 24, close test 8
,ifelse(model_in$TRT=="C",     #if not 10y, test DF
ifelse(model_in$DF_age==12, #test age=12
1, #then timpoint 1
ifelse(model_in$DF_age==36, # if not 12, test age=36
2, #then timpoint 2
3)) #if not 36, then timpoint 3, close test 36 close test 12
,ifelse(model_in$DF_age==11,  #test age=11
1, #then timepoint 1
2  #if not, then timepoint 2
) #close test 11
) #close test DF
) #close test 10y
model_in<-stand_df_age %>% group_by(TRT, SEV, STATUS, DF_age)%>%summarise(YEAR_dbl=median(YEAR_dbl, na.rm = TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else sum(Live_BA_mpha, na.rm=TRUE),count=sum(count, na.rm=TRUE),LRR=sum(LRR, na.rm=TRUE),LRRNO=sum(LRRNO, na.rm=TRUE),SUP=sum(SUP, na.rm=TRUE),No_dam=sum(No_dam, na.rm=TRUE) )
colnames(model_in)[colnames(model_in) == "SEV"] <- "Block"
model_in$timepoint<-
ifelse(model_in$TRT=="A"|model_in$TRT=="B", #test 10y trt
ifelse(model_in$DF_age==8, #test age=8
1, #then timpoint 1
ifelse(model_in$DF_age==24, # if not 8, test age=24
2, #then timpoint 2
3)) #if not 24, then timpoint 3m close test 24, close test 8
,ifelse(model_in$TRT=="C",     #if not 10y, test DF
ifelse(model_in$DF_age==12, #test age=12
1, #then timpoint 1
ifelse(model_in$DF_age==36, # if not 12, test age=36
2, #then timpoint 2
3)) #if not 36, then timpoint 3, close test 36 close test 12
,ifelse(model_in$DF_age==11,  #test age=11
1, #then timepoint 1
2  #if not, then timepoint 2
) #close test 11
) #close test DF
) #close test 10y
model_in_test<-model_in[,c(1,2,3,4,6,12)]
View(model_in_test)
model_in_test<-model_in[,c(1,2,3,6,12)]
vignette("pivot")
