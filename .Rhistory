FVS_StandInit_Input$SLOPE=25
FVS_StandInit_Input$ELEVATION=18
FVS_StandInit_Input$INV_PLOT_SIZE=20
FVS_StandInit_Input$BRK_DBH=999
FVS_StandInit_Input$NUM_PLOTS=5
FVS_StandInit_Input$NONSTK_PLOTS=0
FVS_StandInit_Input$REGION=6
FVS_StandInit_Input$FOREST=12
FVS_StandInit_Input$VARIANT<-"pn"
FVS_StandInit_Input$AGE=0
FVS_StandInit_Input$GROUPS<-"All_Stands"
