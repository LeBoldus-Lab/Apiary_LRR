BA50_plots_1990+BA50_plots_2020
QMD_1990_95CI<-BA50_summary_1990%>%group_by(TRT) %>% summarise(QMD_mean=mean(QMD),SE=(sd(QMD)/sqrt(n())), lower=QMD_mean-SE, upper=QMD_mean+SE,CI=qt(0.975,df=(n()-1))*SE,lower.CI=QMD_mean-CI,upper.CI=QMD_mean+CI)
QMD_2020_95CI<-BA50_summary_2020%>%group_by(TRT) %>% summarise(QMD_mean=mean(QMD),SE=(sd(QMD)/sqrt(n())), lower=QMD_mean-SE, upper=QMD_mean+SE,CI=qt(0.975,df=(n()-1))*SE,lower.CI=QMD_mean-CI,upper.CI=QMD_mean+CI)
QMD_1990_95CI$year<-"1990"
QMD_2020_95CI$year<-"2020"
QMD_combined<-rbind(QMD_1990_95CI,QMD_2020_95CI)
QMD_1990_plot<-ggplot(QMD_1990_95CI,aes(TRT,QMD_mean))+
geom_point(aes(color=TRT))+
geom_errorbar(aes(ymin=lower.CI,ymax=upper.CI, color=TRT),width=0.2)+
labs(y='1990 Stand Quadratic Mean (+/- 95% CI) Diameter (cm)')+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(),legend.position = "none")
