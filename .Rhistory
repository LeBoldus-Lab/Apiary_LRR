dbh_plot_early<-ggplot(growth_test_early,aes(DF_age,live_DBH_cm,colour=Cond_flag))+geom_path(group=growth_test_early$Tree_ID, alpha=0.15, na.rm = TRUE)+theme_bw()+geom_smooth(method = lm)+facet_row(growth_test_early$TRT)+scale_color_viridis_d()
dbh_plot_early
##keep ages 36,45 i.e. "Late"
