sub_mort<- subplot_ABC %>%
ggplot(aes(x=SEV, fill=STATUS)) +
geom_bar(aes(weight=count), position = "fill")+
ylab("Proportion of Total Trees")+
xlab("Rep/Block/Incidence")+
ggtitle("Mortality Proportion")+
facet_grid(rows=vars(DF_age),vars(Treatment), labeller = label_both)+
scale_fill_viridis_d(begin=0.3) +
theme_bw()
sub_mort
sub_mort_c<- subplot_ABC %>%
ggplot(aes(x=SEV, fill=STATUS)) +
geom_bar(aes(weight=count), position = "stack")+
ylab("Trees")+
xlab("Rep/Block/Incidence")+
ggtitle("Mortality Counts")+
facet_grid(rows=vars(DF_age),vars(Treatment), labeller = label_both)+
scale_fill_viridis_d(begin=0.3) +
geom_hline(yintercept = 170)+
theme_bw()
