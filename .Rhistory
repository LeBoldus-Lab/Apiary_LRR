subplots_and_grid <- block_polys +
geom_label(data=subplot_df, x=subplot_df$loc_X_final, y= subplot_df$loc_Y_final,label= subplot_df$subplot, label.size = NA, size=3, alpha=0.0)+
scale_x_continuous("Grid ft NW",breaks = seq(0,1716,132))+
scale_y_continuous("Grid ft SW",breaks = seq(0,1452,132))+
theme_bw()+
theme(panel.grid.major = element_line(colour="black", size=0.5),panel.grid.minor = element_blank())+
#theme(panel.grid.major = element_blank(),panel.grid.minor = element_blank())+
geom_circle(data=subplot_df,aes(x0 = subplot_df$loc_X_final, y0 = subplot_df$loc_Y_final, r = 26.3))
