geom_vline(data=medCW10_2Dead,aes(xintercept=Median), linetype=2, alpha=0.5)+
geom_vline(data=medCW10_2Alive,aes(xintercept=Median), alpha=0.5)+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
