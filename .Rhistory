library(readxl)
library(readr)
library(tidyverse)
library(ggplot2)
#library(xlsx)
library(ggrepel)
library(patchwork)
library(here)
library(lme4)
library(car)
library(lmerTest)
library(emmeans)
lessA1A3<-readRDS(file=here("raw_data","long_data_keep_lessA1A3.Rds"))
#building from Woods Creek approach
#lessA1A3<-readRDS(file=here("raw_data","long_data_keep_lessA1A3.Rds"))
#creating unique tree ID variable of format TRT_REP_SUBPLOT_TREE
lessA1A3$Tree_ID_TRS<-paste(lessA1A3$TRT_code,lessA1A3$REP,lessA1A3$SUBPLOT,lessA1A3$TREE, sep = "_")
#creating unique subplotplot ID factor varaible of format TRT_REP_SUBPLOT
lessA1A3$Subplot_ID_TRS<-paste(lessA1A3$TRT_code,lessA1A3$REP,lessA1A3$SUBPLOT, sep = "_")
#creating subplot level DF excluding trees with no status recorded (like 1987 measurements for ABDE and 1995 for CDE)
#sources for:
#removing STATUS=NA https://stackoverflow.com/questions/29501188/dplyr-removing-nas-from-group-by-variable
#excluding Live_BA_sq_m = 0 https://stackoverflow.com/questions/54805570/dplyr-summarise-keep-na-if-all-summarised-values-are-na/54805923
#subplot_df<-long_data_keep %>% filter(!is.na(STATUS)) %>% group_by(Subplot_ID_TRS, YEAR_fac,TRT, STATUS, .drop = TRUE) %>% summarise(count = n(), Live_BA_sq_m = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m, na.rm=TRUE))
#using DF age instead of year and adding PW and PW+root rot counts
#converting BA to BA m^2/ha 1/20 acre = 0.02023428 hectares
#creating individual columns for damage types to summarise
lessA1A3$LRR<-ifelse(lessA1A3$SUP_LRR=="NA_LRR",1,NA)
lessA1A3$No_dam<-ifelse(lessA1A3$SUP_LRR=="NA_NA",1,NA)
lessA1A3$SUP<-ifelse(lessA1A3$SUP_LRR=="Suppressed_NA",1,NA)
lessA1A3$LRRNO<-ifelse(lessA1A3$SUP_LRR=="NA_LRR"|lessA1A3$SUP_LRR=="NA_NA",1,NA)
lessA1A3$all_DAM<-ifelse(lessA1A3$SUP_LRR=="NA_LRR"|lessA1A3$SUP_LRR=="NA_NA"|lessA1A3$SUP_LRR=="Suppressed_NA",1,NA)
subplot_df_age<-lessA1A3 %>% filter(!is.na(STATUS)) %>% group_by(Subplot_ID_TRS, DF_age,TRT, STATUS, .drop = TRUE) %>% summarise(count = n(), Live_BA_mpha = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m/0.02023428, na.rm=TRUE),LRR=sum(LRR, na.rm = TRUE), No_dam=sum(No_dam, na.rm = TRUE),SUP=sum(SUP,na.rm = TRUE), LRRNO=sum(LRRNO, na.rm=TRUE),all_DAM=sum(all_DAM, na.rm=TRUE), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE), DF_age=median(DF_age, na.rm = TRUE))
#subplot_df_year<-lessA1A3 %>% filter(!is.na(STATUS)) %>% group_by(Subplot_ID_TRS, YEAR_dbl,TRT, STATUS, .drop = TRUE) %>% summarise(count = n(), #Live_BA_mpha = if(all(is.na(Live_BA_sq_m))) NA_real_ else sum(Live_BA_sq_m/0.02023428, na.rm=TRUE),PW=sum(!is.na(PW)), PW_R=sum(!is.na(PW_R)), #DF_age=median(DF_age, na.rm = TRUE))
# 1 sq m = 10.7639 sq ft
#subplot_df_age$Live_BA_sq_ft<-subplot_df_age$Live_BA_sq_m*10.7639
#subplot_df_age$Live_BA_fpa<-subplot_df_age$Live_BA_sq_ft/.053
#subplot_df_year$Live_BA_sq_ft<-subplot_df_year$Live_BA_sq_m*10.7639
#subplot_df_year$Live_BA_fpa<-subplot_df_year$Live_BA_sq_ft/.053
#adding the separate TMT, BLOCK, and PLOT columns
subplot_df_age<-subplot_df_age %>% separate(Subplot_ID_TRS, c("TRT","REP","SUBPLOT"),"_",remove = FALSE)
#subplot_df_year<-subplot_df_year %>% separate(Subplot_ID_TRS, c("TRT","REP","SUBPLOT"),"_",remove = FALSE)
#adding sq ft/acr in addition to sq m/ha  1m/ha = 4.356 ft/a
subplot_df_age$Live_BA_fpa<-subplot_df_age$Live_BA_mpha*4.356
#subplot_df_year$Live_BA_fpa<-subplot_df_year$Live_BA_mpha*4.356
#subplot_df_age$TRT<-as.factor(subplot_df_age$TRT)
#subplot_df_age$REP<-as.factor(subplot_df_age$REP)
#subplot_df_age$SUBPLOT<-as.factor(subplot_df_age$SUBPLOT)
#creating unique stand ID factor varaible of format TRT_BLOCK
subplot_df_age$Stand_ID_TR<-paste(subplot_df_age$TRT,subplot_df_age$REP, sep = "_")
#subplot_df_year$Stand_ID_TR<-paste(subplot_df_year$TRT,subplot_df_year$REP, sep = "_")
# updating to calculate stand-level Live-BA mph and fpa by taking the mean of subplots rather than summing so I can account for missing data/subplots
#instead I will just use REP and as a proxy for FVS parameter related to initial incidence, since that is what was used to determine the blocking anyway. Rep 1=0.2, Rep 2=0.4, Rep 3=0.6 Rep 4=0.8 Rep 0=1.0
stand_df_age<- subplot_df_age %>% filter(!is.na(STATUS)) %>% group_by(Stand_ID_TR, DF_age, TRT, STATUS, .drop = TRUE) %>% summarise(count = sum(count, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else mean(Live_BA_mpha, na.rm=TRUE),  LRR=sum(LRR, na.rm = TRUE), No_dam=sum(No_dam, na.rm = TRUE),SUP=sum(SUP,na.rm = TRUE), LRRNO=sum(LRRNO, na.rm=TRUE),all_DAM=sum(all_DAM, na.rm=TRUE), YEAR_dbl=median(YEAR_dbl, na.rm = TRUE))
#stand_df_year<- subplot_df_year %>% filter(!is.na(STATUS)) %>% group_by(Stand_ID_TR, YEAR_dbl, TRT, STATUS, .drop = TRUE) %>% summarise(count = #sum(count, na.rm=TRUE), Live_BA_mpha = if(all(is.na(Live_BA_mpha))) NA_real_ else mean(Live_BA_mpha, na.rm=TRUE), PW=sum(PW), PW_R=sum(PW_R), #DF_age=median(DF_age, na.rm = TRUE))
#adding the separate REP column
stand_df_age<-stand_df_age %>% separate(Stand_ID_TR, c(NA,"REP"),"_",remove = FALSE)
