#checking nonconforming trt entries with "y" instead of "Y"
#unique(C_plots$TRT)
C_plots$TRT[C_plots$TRT=="DF0y"]<-"DF0Y"
D_plots <- read_excel("C:/Users/showa/Documents/GitHub/Apiary_LRR/raw_data/Apiary_2020_Path_Data_All_for_Jared_2.xlsx",sheet = "D-Plots", col_names = TRUE)
