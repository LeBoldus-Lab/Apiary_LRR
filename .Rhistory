library(readxl)
library(readr)
library(tidyverse)
library(ggplot2)
#library(xlsx)
library(ggrepel)
library(patchwork)
library(here)
library(lme4)
library(car)
library(lmerTest)
library(emmeans)
sp_trees_less_10<-readRDS(here("Initial_LRR_trees_dead_less_than_10_year_in_subplots.Rds"))
sp_trees_less_10$HISTORY<-7
sp_trees_less_10$DAMAGE1<-62
names(sp_trees_less_10)[names(sp_trees_less_10) == 'Diameter'] <- 'DIAMETER'
names(sp_trees_less_10)[names(sp_trees_less_10) == 'Species'] <- 'SPECIES'
View(sp_trees_less_10)
FVS_Stump_Prep<-subset(sp_trees_less_10, sp_trees_less_10$sub_p=="C01"|sp_trees_less_10$sub_p=="C02"|sp_trees_less_10$sub_p=="C03"|sp_trees_less_10$sub_p=="C04"|sp_trees_less_10$sub_p=="C05"|sp_trees_less_10$sub_p=="C11"|sp_trees_less_10$sub_p=="C12"|sp_trees_less_10$sub_p=="C13"|sp_trees_less_10$sub_p=="C14"|sp_trees_less_10$sub_p=="C15"|sp_trees_less_10$sub_p=="C21"|sp_trees_less_10$sub_p=="C22"|sp_trees_less_10$sub_p=="C23"|sp_trees_less_10$sub_p=="C24"|sp_trees_less_10$sub_p=="C25"|sp_trees_less_10$sub_p=="C31"|sp_trees_less_10$sub_p=="C32"|sp_trees_less_10$sub_p=="C33"|sp_trees_less_10$sub_p=="C34"|sp_trees_less_10$sub_p=="C35"|sp_trees_less_10$sub_p=="C41"|sp_trees_less_10$sub_p=="C42"|sp_trees_less_10$sub_p=="C43"|sp_trees_less_10$sub_p=="C44"|sp_trees_less_10$sub_p=="C45")
View(FVS_Stump_Prep)
df<-data.frame(str_split_fixed(FVS_Stump_Prep$sub_p, "", 3))
colnames(df)<- c("TRT_code","BLOCK","SUBPLOT")
#renaming Block 0 to Block 5
df$BLOCK<-as.numeric(ifelse(df$BLOCK==0,5,df$BLOCK))
df$SUBPLOT<-as.numeric(df$SUBPLOT)
FVS_Stump_Prep<-cbind(FVS_Stump_Prep,df)
FVS_Stump_Prep$Tnum<-as.numeric(ifelse(FVS_Stump_Prep$TRT_code=="A",1,
ifelse(FVS_Stump_Prep$TRT_code=="B",2,
ifelse(FVS_Stump_Prep$TRT_code=="C",3,
ifelse(FVS_Stump_Prep$TRT_code=="D",4,
5)))))
FVS_Stump_Prep$StandNum<-as.numeric(((FVS_Stump_Prep$Tnum -1)*5)+FVS_Stump_Prep$BLOCK)
FVS_Stump_Prep$PlotNum<-as.numeric(((FVS_Stump_Prep$StandNum -1)*5)+as.numeric(FVS_Stump_Prep$SUBPLOT))
FVS_Stump_Prep$StandNum<-as.numeric(((FVS_Stump_Prep$Tnum -1)*5)+FVS_Stump_Prep$BLOCK)
FVS_Stump_Prep$PlotNum<-as.numeric(((FVS_Stump_Prep$StandNum -1)*5)+as.numeric(FVS_Stump_Prep$SUBPLOT))
#create an input file based on template and input data
FVS_TreeInit_Test2 = data.frame(matrix(nrow = nrow(FVS_Stump_Prep), ncol = ncol(FVS_TreeInit)))
write.csv(FVS_Stump_Prep,here("FVS_stumps.csv"))
write.csv(FVS_Stump_Prep,here("FVS_inputs","FVS_stumps_trtC.csv"))
write.csv(FVS_Stump_Prep,here("FVS_inputs_update","FVS_stumps_trtC.csv"))
