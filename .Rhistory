wide_for_dam$TMT<-factor(wide_for_dam$TMT, levels= c("DF","RA 12","CW 12","RA 25","CW 25"))
saveRDS(wide_for_dam, file= here("wide_stand_summaries_including_damage_codes_timepoint_update.Rds"))
#early total mortality
EMTFmodel<-lmer(early_prop_dead_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
