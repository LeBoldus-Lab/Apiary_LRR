EMaF<-lm(early_asn_prop_dead_slope ~ TMT , data = ANOVA_early)
plot(EMaF)
summary(EMaF)
anova(EMaF)
EMaF.rg1<-ref_grid(EMaF)
summary(EMaF.rg1)
elsm<-summary(EMaF.rg1)
#backtransform mortality estimates for reporting but not SE (is meaningless backtransformed)
elsm$backtran<-(sin(elsm$prediction))^2
elsm
#doing post-hoc tests
EMaF.em<-emmeans(EMaF, "TMT")
EMaF_posthoc<-pairs(EMaF.em, adjust="tukey")
EMaF_posthoc
plot(EMaF.em,comparisons = TRUE)
#early mort
EMaF.df<-as.data.frame(EMaF.em)
EMaF.df$TMT<-as.factor(c("RA 12Y", "CW 12Y","RA 25Y","CW 25Y"))
EMaF.df$TMT<- ordered(EMaF.df$TMT, levels = c("RA 12Y","CW 12Y","RA 25Y","CW 25Y"))
#adding posthoc results
EMaF.df$tukey<-c("a","ab","b","ab")
EMaF.df$lower<-EMaF.df$emmean-EMaF.df$SE
EMaF.df$upper<-EMaF.df$emmean+EMaF.df$SE
EMaF.df$backtran<-(sin(EMaF.df$emmean))^2
EMaF.df$CL<-EMaF.df$upper.CL-EMaF.df$emmean
EMaF.df$backtran_CL<-(sin(EMaF.df$CL))^2
EMaF.df$backtran_upper.CL<-EMaF.df$backtran+EMaF.df$backtran_CL
EMaF.df$backtran_lower.CL<-EMaF.df$backtran-EMaF.df$backtran_CL
Emort_bar<-ggplot(EMaF.df,aes(TMT,backtran))+
geom_col(aes(fill=TMT))+
#geom_errorbar(aes(ymin=lower,ymax=upper),width=0.2)+
labs(title="Early" ,x="",y='Stand Mean Annual Mortality')+
scale_fill_manual(values=trt_colors[c(1,2,4,5)])+
geom_text(aes(label=tukey,y= elsm$backtran+0.001),show.legend = FALSE)+
theme_bw()+
theme(panel.grid = element_blank(),panel.background = element_blank(),legend.position = "none")#+
#ylim(-0,0.05)
Emort_bar
