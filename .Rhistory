mlint<-sapply(ranef(MaLRRmodel),"[",1)
View(mlint)
mlint<-sapply(ranef(MaLRRmodel),"[[",1)
View(mlint)
class(mlint)
mlint$backtran<-(sin(mlint$Block))^2
mlint
mlint_backtran<-(sin(mlint))^2
mlint_backtran
