med10_1DEAD<-subset(RA10_R1, ALIVE=="DEAD") %>% group_by(DF_age, SUBPLOT, ALIVE) %>% summarise(Median=median(DBH_mm))
#X position using dummy value
Label_ALIVE$DBH_mm <- 150
Label_DEAD$DBH_mm <- 150
pRA10_1<-ggplot(data=subset(RA10_R1, !is.na(ALIVE)) ,aes(DBH_mm,fill=ALIVE))+
geom_histogram(position="stack", bins=20)+scale_fill_viridis_d(begin = 0.3, end = 0.9)+
labs(title= "Size distrubtion of trees in RA10 Rep 1 by Age and Subplot",x="DBH (mm)",y= "Trees") +
geom_text(data = Label_ALIVE,aes(x=DBH_mm,y=10,label=N))+
geom_text(data = Label_DEAD,aes(x=DBH_mm,y=9,label=N))+
geom_vline(data=med10_1DEAD,aes(xintercept=Median), linetype=2)+
geom_vline(data=med10_1ALIVE,aes(xintercept=Median))+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))+
facet_grid(rows=vars(DF_age),vars(SUBPLOT), labeller = label_both)
