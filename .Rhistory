library(survival)
library(ranger)
library(ggfortify)
#select relevant columns from tree-level wide data set
survival_keep<-c("Tree_ID","REP","TRT_code","DEAD_YEAR","STS_2011","NSTS")
survival_data<-as.data.frame(full_data[,(colnames(full_data) %in% survival_keep)])
#remove reps 1 and 3 from RA12
survival_data<-survival_data[-(which(survival_data$TRT_code=="A"& survival_data$REP=="1")),]
survival_data<-survival_data[-(which(survival_data$TRT_code=="A"& survival_data$REP=="3")),]
#assign status=0 for trees that were alive in 2020 and status=1 to trees that died during the study
survival_data$status<-ifelse(survival_data$NSTS=="1",0,1)
#use combination of TRT_code, NSTS, and DEAD_year to calculate "survival time" for each tree.
#to simplify calculating survival time, start with assigning a start year for each treatment
survival_data$begin<-ifelse(survival_data$TRT_code=="A"|survival_data$TRT_code=="B",
1987,
ifelse(survival_data$TRT_code=="C",
1975, 2000))
survival_data$time<-ifelse(survival_data$status==0, #if tree is alive in 2020
(2020-survival_data$begin), #subtract begin from 2020
ifelse(survival_data$STS_2011=="1", # if tree is alive in 2011
(2020-survival_data$begin), #then subtract begin from 2020
(survival_data$DEAD_YEAR- survival_data$begin) #if not, then subtract begin from DEAD_YEAR
)
)
#use "LRR_list" and "SUP_list" to add grouping flags to trees. From lines 2808 and 2810
survival_data$Cond_flag<-    ifelse(survival_data$Tree_ID %in% LRR_list, # test LRR
"LRR", #if so, print LRR
ifelse(survival_data$Tree_ID %in% SUP_list,#if not, test SUPP
"SUP", #if so, print SUP
"NONE")) #if not, print NONE
#now try making survival object and Kaplan-Meier estimates
km<-Surv(survival_data$time, survival_data$status)
km_fit <- survfit(Surv(survival_data$time, survival_data$status) ~ 1)
summary(km_fit, times = c(5*(1:9)))
pkm<-autoplot(km_fit, xlim=c(0,50))
pkm
#split by condition flag
km_cond_fit <- survfit(Surv(time, status) ~ Cond_flag, data = survival_data)
summary(km_cond_fit, times = c(5*(1:9)))
pkmc<-autoplot(km_cond_fit, xlim=c(0,50),xlab = "Years")
pkmc
#rerunning with just DF treatment
dfsurv<-survival_data[which(survival_data$TRT_code=="C"),]
#split by condition flag
df_fit <- survfit(Surv(time, status) ~ 1, data = dfsurv)
p0<-autoplot(df_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in Continuous Rotation")
df_cond_fit <- survfit(Surv(time, status) ~ Cond_flag, data = dfsurv)
p0
summary(df_cond_fit, times = c(5*(1:9)))
p0c<-autoplot(df_cond_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in Continuous Rotation")
p0c
#could run for TRTs A and B together as well
ABsurv<-survival_data[which(survival_data$TRT_code=="A"|survival_data$TRT_code=="B"),]
#split by condition flag
ABsurv_fit <- survfit(Surv(time, status) ~ 1, data = ABsurv)
p12<-autoplot(ABsurv_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in 12y Rotation", ylim = c(0,1))
ABsurv_cond_fit <- survfit(Surv(time, status) ~ Cond_flag, data = ABsurv)
p12
summary(ABsurv_cond_fit, times = c(5*(1:9)))
p12c<-autoplot(ABsurv_cond_fit, xlim=c(0,50),xlab = "Years",ylab = "Survival of Douglas Fir in 12y Rotation")
p12c
p0+p12
p0c+p12c
#pdf(here("Summary_Graphs_update","Surv_curve_by_condition_12y_vs_DF.pdf"), height= 6, width = 12)
#p0c+p12c
#dev.off()
#trying a cox proportional hazard model to include covariates
#this probably shouldn't be done on the full dataset since it seems to think that ABDE treatments die after there are no more measurements
cox<- coxph(Surv(time,status) ~ TRT_code + REP + Cond_flag, data = survival_data)
summary(cox)
cox_fit <- survfit(cox)
pc<-autoplot(cox_fit, xlim=c(0,50))
pc
pkm|pc
#may need to specify reference levels for all of the variables (TRT_code C, Cond_flag= NONE, REP=1)
pdf(here("Summary_Graphs_update","Surv_curve_12y_vs_DF.pdf"), height= 6, width = 12)
p0+p12
dev.off()
