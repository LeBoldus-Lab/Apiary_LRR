EaLRRmodel<-lmer(early_asn_prop_LRR_dead_slope ~ TMT + (1|Block), data = ANOVA_early, REML=FALSE, verbose = 2)
plot(EaLRRmodel, type = c("p", "smooth"))
plot(EaLRRmodel, sqrt(abs(resid(.))) ~ fitted(.),type = c("p", "smooth"))
lattice::qqmath(EaLRRmodel, id = 0.05)
summary(EaLRRmodel)
anova(EaLRRmodel)
rand(EaLRRmodel)
ranef(EaLRRmodel)
VarCorr(EaLRRmodel)
ls_means(EaLRRmodel)
ellsm<-ls_means(EaLRRmodel)
#backtransform mortality estimates for reporting
ellsm$backtran<-(sin(ellsm$Estimate))^2
ellsm$backtran_se<-(sin(ellsm$`Std. Error`))^2
#ranef() produces a list of dataframes and we want to take the first (only) element and backtransform it
elint_backtran<-(sin(sapply(ranef(EaLRRmodel),"[[",1)))^2
elint_backtran
