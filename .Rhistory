###FINISH THE VECTOR ABOVE WITH THE OTHER GROUPS
GFK_Input = data.frame(matrix(nrow = length(GROUPS), ncol = ncol(FVS_GroupAddFilesAndKeywords)))
colnames(GFK_Input)<-colnames(FVS_GroupAddFilesAndKeywords)
GFK_Input$GROUPS<-GROUPS
GFK_Input$FVSKEYWORDS<-FVSKEYWORDS
FVS_StandInit <- read_excel("C:/Users/showa/Documents/GitHub/Apiary_LRR/FVS_inputs/FVS_Input_Template.xlsx", sheet = "FVS_StandInit", range = "A1:BP1", col_names = TRUE)
FVS_TreeInit <- read_excel("C:/Users/showa/Documents/GitHub/Apiary_LRR/FVS_inputs/FVS_Input_Template.xlsx", sheet = "FVS_TreeInit", range = "A1:AM1", col_names = TRUE)
FVS_PlotInit <- read_excel("C:/Users/showa/Documents/GitHub/Apiary_LRR/FVS_inputs/FVS_Input_Template.xlsx", sheet = "FVS_PlotInit", range = "A1:BU1", col_names = TRUE)
#A0 Treatment A REP "0" is being called Treatment 1 Stand 5,  A1 = Stand 1, A2= stand 2, A3= Stand 3, A4= Stand 4
lessA1A3<-readRDS(file="C:/Users/showa/Documents/GitHub/Apiary_LRR/raw_data/long_data_keep_lessA1A3.Rds")
#Calculate necessary ID variables
FVS_Prep<-filter(lessA1A3, FVS_age==0 & !is.na(Tree_status))
FVS_Prep$Tnum<-as.numeric(ifelse(FVS_Prep$TRT_code=="A",1,
ifelse(FVS_Prep$TRT_code=="B",2,
ifelse(FVS_Prep$TRT_code=="C",3,
ifelse(FVS_Prep$TRT_code=="D",4,
5)))))
FVS_Prep$BLOCK<-as.numeric(ifelse(FVS_Prep$REP==0,5,FVS_Prep$REP))
FVS_Prep$StandNum<-as.numeric(((FVS_Prep$Tnum -1)*5)+FVS_Prep$BLOCK)
FVS_Prep$PlotNum<-as.numeric(((FVS_Prep$StandNum -1)*5)+as.numeric(FVS_Prep$SUBPLOT))
#create an input file based on template and input data
FVS_TreeInit_Test = data.frame(matrix(nrow = nrow(FVS_Prep), ncol = ncol(FVS_TreeInit)))
# assign column names
colnames(FVS_TreeInit_Test) = colnames(FVS_TreeInit)
#populate
FVS_TreeInit_Test$STAND_CN<-FVS_Prep$StandNum
FVS_TreeInit_Test$STAND_CN <- sprintf("%02d",FVS_TreeInit_Test$STAND_CN) # fix to 2 characters
FVS_TreeInit_Test$STAND_ID<-FVS_TreeInit_Test$STAND_CN
FVS_TreeInit_Test$PLOT_ID<-FVS_Prep$PlotNum
FVS_TreeInit_Test$PLOT_ID <- sprintf("%03d",FVS_TreeInit_Test$PLOT_ID) # fix to 3 characters
FVS_TreeInit_Test$PLOT_CN<-FVS_TreeInit_Test$PLOT_ID
FVS_TreeInit_Test$STANDPLOT_CN<-paste0(FVS_TreeInit_Test$STAND_CN,FVS_TreeInit_Test$PLOT_CN)
FVS_TreeInit_Test$STANDPLOT_CN <- sprintf("%05s",FVS_TreeInit_Test$STANDPLOT_CN) # fix to 5 characters
FVS_TreeInit_Test$STANDPLOT_ID<-FVS_TreeInit_Test$STANDPLOT_CN
FVS_TreeInit_Test$TREE_ID<-FVS_Prep$Tree_ID
FVS_TreeInit_Test$HISTORY<-ifelse(FVS_Prep$STATUS=="3","7",FVS_Prep$STATUS)
FVS_TreeInit_Test$DIAMETER<-(FVS_Prep$DBH_mm * 0.03937)
FVS_TreeInit_Test$SPECIES<-"DF"
FVS_TreeInit_Test$VARIANT<-"pn"
trees_less_10_sub<-readRDS("C:/Users/showa/Documents/GitHub/Apiary_LRR/Initial_LRR_trees_dead_less_than_10_year.Rds")
#trees_less_10_sub<-readRDS("C:/Users/showalt_d/Documents/GitHub/Apiary_LRR/Initial_LRR_trees_dead_less_than_10_year.Rds")
sp_trees_less_10<-readRDS("C:/Users/showa/Documents/GitHub/Apiary_LRR/Initial_LRR_trees_dead_less_than_10_year_in_subplots.Rds")
#sp_trees_less_10<-readRDS("C:/Users/showalt_d/Documents/GitHub/Apiary_LRR/Initial_LRR_trees_dead_less_than_10_year_in_subplots.Rds")
#adding damage code =62 for LRR, history=7 dead and update column names to FVS format
sp_trees_less_10$HISTORY<-7
sp_trees_less_10$DAMAGE1<-62
names(sp_trees_less_10)[names(sp_trees_less_10) == 'Diameter'] <- 'DIAMETER'
names(sp_trees_less_10)[names(sp_trees_less_10) == 'Species'] <- 'SPECIES'
#can then subset sp_trees_less_10 based on subplots to generate outputs
#Calculate necessary ID variables
FVS_Stump_Prep<-subset(sp_trees_less_10, sp_trees_less_10$sub_p!="A11"&sp_trees_less_10$sub_p!="A12"&sp_trees_less_10$sub_p!="A13"&sp_trees_less_10$sub_p!="A14"&sp_trees_less_10$sub_p!="A15"&sp_trees_less_10$sub_p!="A31"&sp_trees_less_10$sub_p!="A32"&sp_trees_less_10$sub_p!="A33"&sp_trees_less_10$sub_p!="A34"&sp_trees_less_10$sub_p!="A35")
#split subplot ID to get TRT BLOCK and SUBPLOP IDS
df<-data.frame(str_split_fixed(FVS_Stump_Prep$sub_p, "", 3))
colnames(df)<- c("TRT_code","BLOCK","SUBPLOT")
#renaming Block 0 to Block 5
df$BLOCK<-as.numeric(ifelse(df$BLOCK==0,5,df$BLOCK))
df$SUBPLOT<-as.numeric(df$SUBPLOT)
FVS_Stump_Prep<-cbind(FVS_Stump_Prep,df)
FVS_Stump_Prep$Tnum<-as.numeric(ifelse(FVS_Stump_Prep$TRT_code=="A",1,
ifelse(FVS_Stump_Prep$TRT_code=="B",2,
ifelse(FVS_Stump_Prep$TRT_code=="C",3,
ifelse(FVS_Stump_Prep$TRT_code=="D",4,
5)))))
FVS_Stump_Prep$StandNum<-as.numeric(((FVS_Stump_Prep$Tnum -1)*5)+FVS_Stump_Prep$BLOCK)
FVS_Stump_Prep$PlotNum<-as.numeric(((FVS_Stump_Prep$StandNum -1)*5)+as.numeric(FVS_Stump_Prep$SUBPLOT))
#create an input file based on template and input data
FVS_TreeInit_Test2 = data.frame(matrix(nrow = nrow(FVS_Stump_Prep), ncol = ncol(FVS_TreeInit)))
# assign column names
colnames(FVS_TreeInit_Test2) = colnames(FVS_TreeInit)
#populate
FVS_TreeInit_Test2$STAND_CN<-FVS_Stump_Prep$StandNum
FVS_TreeInit_Test2$STAND_CN <- sprintf("%02d",FVS_TreeInit_Test2$STAND_CN) # fix to 2 characters
FVS_TreeInit_Test2$STAND_ID<-FVS_Stump_Prep$StandNum
FVS_TreeInit_Test2$STAND_ID <- sprintf("%02d",FVS_TreeInit_Test2$STAND_ID) # fix to 2 characters
FVS_TreeInit_Test2$PLOT_ID<-FVS_Stump_Prep$PlotNum
FVS_TreeInit_Test2$PLOT_ID <- sprintf("%03d",FVS_TreeInit_Test2$PLOT_ID) # fix to 3 characters
FVS_TreeInit_Test2$PLOT_CN<-FVS_Stump_Prep$PlotNum
FVS_TreeInit_Test2$PLOT_CN <- sprintf("%03d",FVS_TreeInit_Test2$PLOT_CN) # fix to 3 characters
FVS_TreeInit_Test2$STANDPLOT_CN<-paste0(FVS_TreeInit_Test2$STAND_CN,FVS_TreeInit_Test2$PLOT_CN)
